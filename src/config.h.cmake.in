#pragma once

/* define location of source directory */
#define PROJECT_SOURCE_DIR_STR "@PROJECT_SOURCE_DIR@"

/* define the major version */
#define AF_APP_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@

/* define the minor version */
#define AF_APP_VERSION_MINOR  @PROJECT_VERSION_MINOR@

/* define the patch version */
#define AF_APP_VERSION_PATCH  @PROJECT_VERSION_PATCH@

/* define the version */
#define AF_APP_VERSION "@PROJECT_VERSION@"

/* define the release version */
#define AF_APP_BUILD_TYPE "@CMAKE_BUILD_TYPE@"

/* building from Git repository or not */
#cmakedefine IS_GIT_PROJECT

/* Assume MKL library is available. */ 
#cmakedefine HAVE_MKL

/* Enable device code and use CUDA backend */
#cmakedefine ENABLE_CUDA

/* Enable device code and use HIP backend */
#cmakedefine ENABLE_HIP
 
/* Enable device code, with some backend. */
#cmakedefine ENABLE_DEVICE

/* Reproduce the result of the host code exactly by using an inefficient copy-from-host random number generator */
#cmakedefine DEVICE_RNG_FROM_HOST

/* Enable spdlog */
#cmakedefine ENABLE_SPDLOG

/* Enable cpptrace */
#cmakedefine ENABLE_CPPTRACE

