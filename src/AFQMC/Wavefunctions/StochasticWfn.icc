namespace
{
// Stable complex sum of P-sample terms (log-sum-exp). shift = max log|t_p|;
// returns sum_p t_p without underflow when magnitudes span decades.
inline ComplexType stable_complex_sum(ComplexType const* terms, int n)
{
  double shift = -std::numeric_limits<double>::infinity();
  for (int i = 0; i < n; ++i)
  {
    const double a = std::abs(terms[i]);
    if (a > 0.0)
    {
      const double l = std::log(a);
      if (l > shift)
        shift = l;
    }
  }
  if (not std::isfinite(shift))
    return ComplexType(0.0);
  const RealType scale = std::exp(-shift);
  ComplexType acc(0.0);
  for (int i = 0; i < n; ++i)
  {
    const double a = std::abs(terms[i]);
    if (a > 0.0)
      acc += terms[i] * scale;
  }
  return std::exp(shift) * acc;
}


} // namespace

namespace stochastic_wfn_detail
{
inline nda::array<ComplexType, 3> guess_matrices_to_rank3(std::vector<nda::matrix<ComplexType>> const& guess,
                                                          int naeb)
{
  utils::check(not guess.empty(), "StochasticWfn: empty initial guess.");
  const int nspin = int(guess.size());
  const int NMO   = int(guess[0].extent(0));
  const int naea  = int(guess[0].extent(1));
  nda::array<ComplexType, 3> A(nspin, NMO, naea);
  A(0, nda::ellipsis{}) = guess[0];
  if (nspin > 1)
    A(1, nda::range::all, nda::range(naeb)) = guess[1];
  return A;
}
} // namespace stochastic_wfn_detail

template<MEMORY_SPACE MEM, class devPsiT>
StochasticWfn<MEM, devPsiT>::StochasticWfn(std::string system,
                                             int NMO_,
                                             int nup_,
                                             int ndown_,
                                             ptree pt_in,
                                             std::shared_ptr<utils::mpi_context_t<mpi3::communicator>> mpi_in,
                                             HamiltonianOperations<MEM>&& outer_hop_,
                                             nda::array<ComplexType, 1>&& ci_,
                                             nda::array<devPsiT, 2>&& orbs_,
                                             std::unique_ptr<StochasticInnerStack<MEM, devPsiT>>&& inner_stack_in,
                                             WALKER_TYPES wlk,
                                             [[maybe_unused]] int targetNW)
    : system_(std::move(system)),
      NMO{NMO_},
      nup{nup_},
      ndown{ndown_},
      mpi_(std::move(mpi_in)),
      nomsd_(nomsd_inputs(pt_in), NMO_, nup_, ndown_, wlk, mpi_, std::move(outer_hop_), std::move(ci_),
             std::move(orbs_), targetNW),
      inner_stack_(std::move(inner_stack_in))
{
  if (inner_stack_ == nullptr)
    APP_ABORT("Error in StochasticWfn: inner stack must be provided (see WavefunctionFactory).");
  ptree pt = interpret_inputs(pt_in);
  inner_n_samples_    = pt.get<int>("inner_n_samples");
  inner_nsteps_      = pt.get<int>("inner_nsteps");
  inner_sampling_target_        = parse_sampling_target(pt.get<std::string>("inner_sampling_target"));
  inner_burn_in_ = pt.get<int>("inner_burn_in");
  inner_sample_update_steps_ = pt.get<int>("inner_sample_update_steps");
  inner_n_measure_samples_ = pt.get<int>("inner_n_measure_samples");
  inner_sampler_        = pt.get<std::string>("inner_sampler");
  inner_sampler_step_   = pt.get<double>("inner_sampler_step");
  int inner_seed     = pt.get<int>("inner_seed");
  inner_ensemble_.rng =
      std::make_shared<utils::RandomGenerator_t<HOST_MEMORY>>(utils::split_seed(inner_seed, mpi_->comm));
  if (auto prop_pt = pt.get_child_optional("inner_propagator"))
  {
    // No default. For a trained trial the factory injects the timestep it read from the variational
    // Hamiltonian's inner_timestep attribute; for a synthetic trial with no inner_hamiltonian the input
    // must state it. Either way an absent timestep on a dynamic trial is an error, never 0.01.
    if (auto ts = prop_pt->get_optional<double>("timestep"))
      inner_timestep_ = *ts;
    else if (inner_nsteps_ > 0)
      APP_ABORT("Error in StochasticWfn: a dynamic trial needs an inner propagator timestep. It is read "
                "from the variational Hamiltonian's 'inner_timestep' attribute when inner_hamiltonian is "
                "given; without one, set inner_propagator.timestep explicitly. There is no default.");
  }
  else if (inner_nsteps_ > 0)
    APP_ABORT("Error in StochasticWfn: a dynamic trial needs an inner_propagator block carrying the "
              "timestep (supplied automatically from inner_hamiltonian's 'inner_timestep' attribute).");
  if (inner_nsteps_ > 0)
  {
    if (wlk != CLOSED && wlk != COLLINEAR)
      APP_ABORT("Error in StochasticWfn: inner_nsteps > 0 (dynamic stochastic trial) currently supports "
                "CLOSED (RHF) and COLLINEAR (UHF) trials only -- NONCOLLINEAR full-G is a follow-up.");
    // Dynamic trials are gated to HOST_MEMORY. Key this on MEM, not on `#if defined(ENABLE_DEVICE)`:
    // a CUDA build still instantiates and runs HOST_MEMORY StochasticWfn (e.g. the dual-memory unit
    // tests' CPU subsection), which must behave exactly like a CPU-only build. `if constexpr (MEM ==
    // DEVICE_MEMORY)` forbids only the device instantiation; the off-anchor device method bodies are
    // separately compile-time gated (if constexpr (MEM == HOST_MEMORY)) so this abort is the single
    // runtime seam a device dynamic trial hits.
    // PR-3 device port complete for all inner-sampling modes (free-projection, conditioned, leapfrog, and
    // persistent field chains). Persistent chains use a host-RNG hybrid MCMC (same mt19937 stream as a CPU
    // build), so no device construction is rejected here.
  }
  // The only mode constraint left to check at runtime: Static IS inner_nsteps == 0, and the dynamic modes
  // need a nonzero path length. interpret_inputs already rejects the mismatched spellings, so reaching
  // either of these means the two were set inconsistently downstream of it.
  if (inner_sampling_target_ == SamplingTarget::Static && inner_nsteps_ != 0)
    APP_ABORT("Error in StochasticWfn: inner_sampling_target = static is the inner_nsteps = 0 replicated anchor "
              "ensemble, but inner_nsteps = " +
              std::to_string(inner_nsteps_) + " was given. Use inner_sampling_target = free or conditioned.");
  if (inner_sampling_target_ != SamplingTarget::Static && inner_nsteps_ <= 0)
    APP_ABORT("Error in StochasticWfn: inner_sampling_target = " + to_string(inner_sampling_target_) +
              " is a dynamic sampler and requires inner_nsteps > 0.");
  // Persistent-chain input validation. The chains are not optional: inner_persistence() is true for
  // every conditioned dynamic trial, so this block validates the sampler settings of the ONE conditioned
  // mode rather than those of an opt-in path.
  if (inner_persistence())
  {
    if (inner_sample_update_steps_ < 0)
      APP_ABORT("Error in StochasticWfn: inner_sample_update_steps must be >= 0.");
    if (inner_burn_in_ < 0)
      APP_ABORT("Error in StochasticWfn: inner_burn_in must be >= 0.");
    if (inner_sampler_ == "metropolis")
      APP_ABORT("Error in StochasticWfn: inner_sampler = 'metropolis' (the determinant-space independence "
                "sampler) has been replaced by field-space kernels; use 'pcn' (equivalent physics at "
                "inner_sampler_step = 1) or 'gaussian'.");
    if (inner_sampler_ != "pcn" && inner_sampler_ != "gaussian")
      APP_ABORT("Error in StochasticWfn: inner_sampler = '" + inner_sampler_ +
                "' is not implemented; available field-space kernels: 'pcn', 'gaussian'.");
    if (inner_sampler_ == "pcn" && (inner_sampler_step_ <= 0.0 || inner_sampler_step_ > 1.0))
      APP_ABORT("Error in StochasticWfn: inner_sampler = 'pcn' requires 0 < inner_sampler_step <= 1 "
                "(1 = independence redraw).");
    if (inner_sampler_ == "gaussian" && inner_sampler_step_ <= 0.0)
      APP_ABORT("Error in StochasticWfn: inner_sampler = 'gaussian' requires inner_sampler_step > 0.");
  }
  if (inner_n_measure_samples_ < 1)
    APP_ABORT("Error in StochasticWfn: inner_n_measure_samples must be >= 1.");
  // The real constraint, now stated where it belongs. inner_sample_update_steps = 0 is legal and meaningful (prime the
  // chains, then freeze them) -- but only at nm == 1, because replicas that share a pool state are the
  // same measurement repeated and reduce neither variance nor lag. Previously this was enforced by
  // silently clamping the measurement stride's default to max(1, equil), which made a legal
  if (inner_n_measure_samples_ > 1 && inner_sample_update_steps_ < 1)
    APP_ABORT("Error in StochasticWfn: inner_n_measure_samples > 1 requires inner_sample_update_steps >= 1; with zero "
              "sweeps every replica measures the same frozen pool, which is one measurement repeated.");
  if (inner_n_measure_samples_ > 1 && not inner_persistence())
    APP_ABORT("Error in StochasticWfn: inner_n_measure_samples > 1 (measurement-replica averaging) requires "
              "a conditioned dynamic trial (inner_sampling_target = walker_overlap, inner_nsteps > 0); a replica IS one "
              "advance of the persistent walker-conditioned field chain, and the static and "
              "free-projection ensembles have no chain to advance.");
  app_log(2, "\nStochasticWfn input:\n{}\n", io::to_string(pt));
}

template<MEMORY_SPACE MEM, class devPsiT>
ptree StochasticWfn<MEM, devPsiT>::interpret_inputs(const ptree pt0)
{
  ptree pt1 = nomsd_inputs(pt0);
  int inner_n_samples = pt0.get<int>("inner_n_samples", 1);
  if (inner_n_samples < 1)
    APP_ABORT("Error in StochasticWfn::interpret_inputs: inner_n_samples must be >= 1.");
  int inner_nsteps = pt0.get<int>("inner_nsteps", 0);
  if (inner_nsteps < 0)
    APP_ABORT("Error in StochasticWfn::interpret_inputs: inner_nsteps must be >= 0.");

  // The sampling mode and the migration off the four booleans it replaces. resolve_sampling_target is shared
  // with WavefunctionFactory::interpret_inputs -- see its comment for why that sharing is load-bearing.
  const std::string inner_sampling_target = resolve_sampling_target(pt0, inner_nsteps);

  int inner_n_measure_samples = pt0.get<int>("inner_n_measure_samples", 1);

  const int inner_sample_update_steps = pt0.get<int>("inner_sample_update_steps", 1);
  // hafqmc: burn_in (--trial-burn-in, default 100). One-time equilibration of the field chains at the
  // prime, before the walk starts; inner_sample_update_steps is what every later advance costs.
  const int inner_burn_in = pt0.get<int>("inner_burn_in", 100);

  std::string inner_sampler = pt0.get<std::string>("inner_sampler", "pcn");
  // proposal step size s: kernel-dependent default. pcn: s = 1 (independence proposal) -- the validated
  // conditioned-path default; the per-step conditioning target moves, so an independence proposal
  // re-equilibrates each step (a P=8 single-rank check reproduced the reference energy to -0.1 mHa),
  // whereas smaller steps lag it at inner_sample_update_steps = 1. gaussian random walk: s = 0.05.
  double inner_sampler_step = pt0.get<double>("inner_sampler_step", inner_sampler == "gaussian" ? 0.05 : 1.0);
  int inner_seed = pt0.get<int>("inner_seed", 777);
  pt1.put("inner_n_samples", inner_n_samples);
  pt1.put("inner_nsteps", inner_nsteps);
  pt1.put("inner_sampling_target", inner_sampling_target);
  pt1.put("inner_sample_update_steps", inner_sample_update_steps);
  pt1.put("inner_burn_in", inner_burn_in);
  pt1.put("inner_n_measure_samples", inner_n_measure_samples);
  pt1.put("inner_sampler", inner_sampler);
  pt1.put("inner_sampler_step", inner_sampler_step);
  pt1.put("inner_seed", inner_seed);
  if (auto prop_pt = pt0.get_child_optional("inner_propagator"))
    pt1.put_child("inner_propagator", *prop_pt);
  std::unordered_set<std::string> pass_through_keys = {
      "system",
      "name",
      "ndets_to_read",
      "restart_file",
      "filename",
      "type",
      "inner_n_samples",
      "inner_nsteps",
      "inner_sampling_target",
      "inner_sample_update_steps",
      "inner_burn_in",
      "inner_n_measure_samples",
      "inner_sampler",
      "inner_sampler_step",
      "inner_seed",
      "inner_propagator",
  };
  // THE inner_* SURFACE IS CLOSED: an unknown inner_* key is a hard error, not a warning.
  //
  // compare_known_keys only warns, and it is shared with every other factory (NOMSD warns routinely on
  // the stripped tree it is handed), so it cannot be made strict globally. But the stochastic keys are
  // ours alone, and a warning is the wrong response to a misspelled one: the run continues with the
  // engine's default while the input file says otherwise -- silently, which is the exact failure mode
  // this surface was cleaned up to remove. Every removed key therefore lands here too, so a deck written
  // against the old names fails loudly and is a one-line fix rather than a quiet reinterpretation.
  {
    std::vector<std::string> unknown;
    for (auto const& item : pt0)
      if (item.first.rfind("inner_", 0) == 0 && pass_through_keys.count(item.first) == 0 &&
          item.first != "inner_hamiltonian") // factory-level: consumed by fromHDF5, never reaches here
        unknown.push_back(item.first);
    if (not unknown.empty())
    {
      std::string names;
      for (auto const& u : unknown)
        names += (names.empty() ? "" : ", ") + u;
      APP_ABORT("Error in StochasticWfn::interpret_inputs: unknown stochastic input key(s): " + names +
                ".\nThe inner_* surface is closed and has no backward compatibility. Settable keys are: "
                "inner_sampling_target, inner_n_samples, inner_nsteps, inner_burn_in, "
                "inner_sample_update_steps, inner_sampler, inner_sampler_step, inner_n_measure_samples, "
                "inner_seed, inner_propagator, inner_hamiltonian.");
    }
  }
  io::compare_known_keys("Stochastic trial wavefunction (StochasticWfn)", pt1, pt0, pass_through_keys);
  return pt1;
}

template<MEMORY_SPACE MEM, class devPsiT>
int StochasticWfn<MEM, devPsiT>::dm_size(bool full) const
{
  return nomsd_.dm_size(full);
}

template<MEMORY_SPACE MEM, class devPsiT>
bool StochasticWfn<MEM, devPsiT>::compact_G_for_vbias() const
{
  return nomsd_.ci.size() == 1;
}

template<MEMORY_SPACE MEM, class devPsiT>
WalkerSet<MEM>& StochasticWfn<MEM, devPsiT>::inner_wset()
{
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::inner_wset: inner walkers not initialized.");
  return *inner_ensemble_.wset;
}

template<MEMORY_SPACE MEM, class devPsiT>
WalkerSet<MEM> const& StochasticWfn<MEM, devPsiT>::inner_wset() const
{
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::inner_wset: inner walkers not initialized.");
  return *inner_ensemble_.wset;
}

template<MEMORY_SPACE MEM, class devPsiT>
void StochasticWfn<MEM, devPsiT>::initialize_inner_walkers(
    ptree const& walker_pt, std::vector<nda::matrix<ComplexType>> const& initial_guess, int NAEB)
{
  if (inner_ensemble_.initialized)
    APP_ABORT("Error in StochasticWfn::initialize_inner_walkers: inner walkers already initialized.");
  auto wt = WalkerSet<MEM>::parse_walker_type(walker_pt);
  inner_ensemble_.wset =
      std::make_unique<WalkerSet<MEM>>(mpi_, walker_pt, inner_ensemble_.rng, wt, initial_guess, inner_n_samples_);
  inner_anchor_ = stochastic_wfn_detail::guess_matrices_to_rank3(initial_guess, NAEB);
  // Cache the construction inputs so mean_field_scratch_ensemble() can build a dedicated scratch walker
  // set on demand via this SAME constructor (see mf_scratch_wset_).
  inner_walker_pt_     = walker_pt;
  inner_initial_guess_ = initial_guess;
  (void)NAEB;
  inner_ensemble_.initialized = true;
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class TVec>
void StochasticWfn<MEM, devPsiT>::Log_Overlap(const WlkSet& wset, TVec&& Ov, int nt)
{
  (void)nt;
  memory::check_memory_space<MEM>(Ov);
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::Log_Overlap: inner walkers not initialized.");
  if (at_delegate_limit())
  {
    nomsd_.Log_Overlap(wset, std::forward<TVec>(Ov), nt);
    return;
  }
  if constexpr (MEM == HOST_MEMORY)
  {
  conditioned_resample(wset);

  WalkerSet<MEM>& inner  = *inner_ensemble_.wset;
  const int nw           = wset.size();
  // With conditioning, inner is block-structured (nw*P walkers, slot-major q = ip*nw + w); pair tk maps
  // to outer walker iw = tk % nw and inner walker q = tk (its own conditioned sample). Without
  // conditioning, inner has P shared walkers paired against all outer walkers.
  const bool conditioned = (inner_conditioning());
  // Leapfrog: reweight each per-sample term by 1/|<psi_q|phi_q^cond>| (computed at the resample), so
  // old_ovlp = Sum_p S_p and the step overlap RATIO new/old is exactly Eq. 25 (N(phi) cancels). Without
  // leapfrog, the absolute (1/P) Sum_p <psi_p|phi_w> reduction is kept.
  const bool leapfrog    = (conditioned && inner_leapfrog());
  const int P            = (conditioned ? inner_n_samples_ : int(inner.size()));
  utils::check(Ov.size() >= nw, "Size mismatch");
  utils::check(P >= 1, "inner ensemble must be non-empty");
  if (conditioned)
    utils::check(inner.size() == long(nw) * P, "conditioned inner ensemble size mismatch (expect nw*P)");
  if (leapfrog)
    utils::check(inner_cond_mag_.size() == long(nw) * P,
                 "leapfrog inner_cond_mag_ not sized -- conditioned resample must run first");
  const ComplexType inv_P(1.0 / static_cast<double>(P), 0.0);
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  auto all              = nda::range::all;

  Ov() = ComplexType(0.0);

  // Per-rank-local, exactly like NOMSD::Log_Overlap: each rank scores its OWN nw outer walkers against
  // the full inner ensemble (loop the full nw*P pairs) with NO cross-rank distribution / all_reduce. The
  // earlier FairDivide-of-pairs-across-the-comm + all_reduce(Ov, nw) was correct only for REPLICATED outer
  // walkers (the unit tests, where every rank holds the same wset); in the real driver the outer walkers
  // are DISTRIBUTED across ranks, so all-reducing per-walker Ov(iw) summed DIFFERENT physical walkers
  // across ranks -> corrupted overlaps -> bad hybrid weights -> zero-weight walkers tripping pair_branch.
  // Same per-rank-complete contract as the Energy override.
  const int tk0 = 0, tkN = nw * P;

  memory::buffered_array<MEM, ComplexType, 1> log_ov(1, ComplexType(0.0));
  memory::buffered_array<MEM, ComplexType, 3> inner_one(1, NMO, nup);
  memory::buffered_array<MEM, ComplexType, 3> outer_one(1, NMO, nup);

  for (int tk = tk0; tk < tkN; ++tk)
  {
    const int iw = (conditioned ? tk % nw : tk / P);
    const int ip = (conditioned ? tk / nw : tk % P);
    const int inner_idx = conditioned ? tk : ip;
    inner_one(0, all, all) = inner.SlaterMatrices(Alpha)(inner_idx, all, all);
    outer_one(0, all, all) = wset.SlaterMatrices(Alpha)(iw, all, all);
    log_ov(0)              = ComplexType(0.0);
    det_ops::Log_Overlap(inner_one, outer_one, log_ov);
    if (wt == CLOSED)
      nda::tensor::scale(ComplexType(2.0), log_ov);
    ComplexType ov = std::exp(log_ov(0));
    if (wt == COLLINEAR)
    {
      memory::buffered_array<MEM, ComplexType, 3> inner_beta(1, NMO, ndown);
      memory::buffered_array<MEM, ComplexType, 3> outer_beta(1, NMO, ndown);
      inner_beta(0, all, all) = inner.SlaterMatrices(Beta)(inner_idx, all, all);
      outer_beta(0, all, all) = wset.SlaterMatrices(Beta)(iw, all, all);
      log_ov(0)               = ComplexType(0.0);
      det_ops::Log_Overlap(inner_beta, outer_beta, log_ov);
      ov *= std::exp(log_ov(0));
    }
    if (leapfrog)
    {
      // The reweight must match WHICH SAMPLER produced the ensemble in hand, so it is keyed on
      // inner_chains_primed_ (a state fact), not on a mode flag: samples from the force-biased bootstrap
      // resample carry exp(logsw) = p_T/q, samples from the field chains are already distributed as
      // p_T(Y)|<psi|phi>| and are divided by inner_cond_mag_. Before the chains exist -- the driver's
      // pre-loop diagnostic energy, which lands here with an ensemble from advance_inner_ensemble_
      // conditioned -- the logsw form is the correct one.
      if ((not inner_chains_primed_) && inner_logsw_.size() == inner_cond_mag_.size())
      {
        Ov(iw) += std::exp(inner_logsw_(tk)) * ov;
      }
      else
      {
        double mag = double(inner_cond_mag_(tk));
        if (mag > 0.0)
        {
          Ov(iw) += ov / ComplexType(mag, 0.0);
        }
      }
    }
    else
    {
      Ov(iw) += inv_P * ov;
    }
  }

    // The pair loop accumulates the LINEAR effective overlap; OVLP stores the log overlap.
    for (int iw = 0; iw < nw; ++iw)
      Ov(iw) = std::log(Ov(iw));

  }
  else
  {
#if defined(ENABLE_DEVICE)
    // Device (static-anchor only; conditioned / leapfrog / log-aggregate need inner_nsteps > 0, which is
    // forbidden at construction on device). reduce_inner_cross_dm accumulates exactly the linear effective
    // overlap Ov = (1/P) sum_p <psi_p|phi_w> (device-ported); a no-op accumulate discards the mixed DM it
    // also builds. Take the log for the OVLP (log-overlap) convention, as the host pair loop does.
    memory::buffered_array<MEM, ComplexType, 1> Ddummy(wset.size(), ComplexType(0.0));
    reduce_inner_cross_dm(wset, /*compact=*/true, dm_size(false), Ddummy, Ov,
                          [](auto&, auto&, auto&, int, int, int) {});
    kernels::device::elementwise_log(Ov);
#endif
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::Log_Overlap(WlkSet& wset)
{
  if (at_delegate_limit())
  {
    nomsd_.Log_Overlap(wset);
    return;
  }
  // Off-anchor: delegates to the device-safe Log_Overlap(wset, ovlp) (static-anchor ported).
  int nw = wset.size();
  memory::buffered_array<MEM, ComplexType, 1> ovlp(nw, ComplexType(0.0));
  Log_Overlap(wset, ovlp);
  wset.setProperty(OVLP, ovlp);
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class Mat, class TVec>
void StochasticWfn<MEM, devPsiT>::Energy(const WlkSet& wset, Mat&& E, TVec&& Ov, int nt)
{
  (void)nt;
  memory::check_memory_space<MEM>(E, Ov);
  utils::check(E.shape() == std::array<long, 2>{wset.size(), 3}, "Size mismatch");
  utils::check(Ov.size() == wset.size(), "Size mismatch");
  if (at_delegate_limit())
  {
    nomsd_.Energy(wset, std::forward<Mat>(E), std::forward<TVec>(Ov), nt);
    return;
  }
  const int nwalk         = wset.size();
  const ComplexType zero(0.0);
  const bool full         = (inner_nsteps_ > 0);
  const bool compact      = not full;
  const int Gsize         = dm_size(full);

  memory::buffered_array<MEM, ComplexType, 2> eloc2(nwalk, 3);
  memory::buffered_array<MEM, ComplexType, 1> D(nwalk, zero);
  E()  = zero;
  Ov() = zero;

  reduce_inner_cross_dm(
      wset, compact, Gsize, D, Ov,
      [&](auto& Gp, auto& ov_, auto& Sp, int ip, int /*r0*/, int /*rN*/) {
        eloc2() = zero;
        if (full)
          nomsd_.energy_from_fullG(eloc2, Gp);
        else
          nomsd_.energy_from_G(eloc2, Gp, 0);
        // Debug per-sample dump (env SAFIRE_DUMP_PERSAMPLE): raw <psi_ip|phi_0>, the weight s actually used
        // (Sp), and the per-sample local energy, for outer walker 0. Lets us reconstruct E offline as
        // SAFIRE's weighting (sum_p Sp*eloc / sum_p Sp) vs the plain ratio-of-sums (sum_p ov*eloc / sum_p ov).
        if constexpr (MEM == HOST_MEMORY)
          if (nwalk > 0 && mpi_->comm.root())
            dump_persample_row(energy_dump_call_, ip, std::exp(ov_(0)), Sp(0), eloc2(0, 0), eloc2(0, 1),
                               eloc2(0, 2));
        // E[w,:] += Sp[w] * eloc2[w,:]  (per-outer-walker scaled accumulate over the P inner samples).
        if constexpr (MEM == HOST_MEMORY)
          for (int w = 0; w < nwalk; ++w)
            E(w, nda::range::all) += Sp(w) * eloc2(w, nda::range::all);
        else
        {
#if defined(ENABLE_DEVICE)
          kernels::device::row_accumulate(Sp, eloc2, E);
#endif
        }
      });

  // Debug (env SAFIRE_DUMP_SLATER): on the first Energy event, snapshot walker-0's ket phi and the P inner
  // determinants psi_ip (walker 0's block, conditioned slot idx = ip*nwalk) so an external code can
  // recompute <psi_ip|phi> and eloc on the identical determinants. CLOSED/Alpha only (N2 test).
  if constexpr (MEM == HOST_MEMORY)
    if (energy_dump_call_ == 0 && mpi_->comm.root() && want_slater_dump() && inner_ensemble_.wset != nullptr)
    {
      using nda::range;
      auto all             = range::all;
      const int P          = inner_n_samples_;
      const bool cond      = (inner_conditioning());
      WalkerSet<MEM>& innr = *inner_ensemble_.wset;
      const long rows      = wset.SlaterMatrices(Alpha).extent(1); // npol*NMO
      const long naea      = wset.SlaterMatrices(Alpha).extent(2);
      nda::array<ComplexType, 2> phi = wset.SlaterMatrices(Alpha)(0, all, all); // [rows, naea] contiguous
      nda::array<ComplexType, 3> psis(P, rows, naea);
      for (int ip = 0; ip < P; ++ip)
        psis(ip, all, all) = innr.SlaterMatrices(Alpha)(cond ? (long(ip) * nwalk + 0) : long(ip), all, all);
      dump_slater_snapshot(int(rows), int(naea), P, phi.data(), psis.data());
    }
  // Debug (env SAFIRE_DUMP_WALKERS): append walker-0's ket phi for EVERY measurement event (first 32), so
  // an external code can evaluate the true trial local energy on the identical walkers.
  if constexpr (MEM == HOST_MEMORY)
    if (energy_dump_call_ < 32 && mpi_->comm.root() && want_walker_dump())
    {
      auto all                       = nda::range::all;
      const long rows                = wset.SlaterMatrices(Alpha).extent(1);
      const long naea                = wset.SlaterMatrices(Alpha).extent(2);
      nda::array<ComplexType, 2> phi = wset.SlaterMatrices(Alpha)(0, all, all);
      dump_walker_row(energy_dump_call_, int(rows), int(naea), phi.data());
    }
  ++energy_dump_call_;

  // NO all_reduce over E here. nomsd_.energy_from_G / energy_from_fullG (-> HamOp.energy) returns the
  // COMPLETE per-walker energy on every rank -- it performs any internal Cholesky-distribution reduction
  // itself, exactly as NOMSD::Energy relies on (NOMSD does no external all_reduce). reduce_inner_cross_dm
  // also replicates the full inner-walker loop on every rank (it is NOT FairDivided -- unlike the pair
  // loop in Log_Overlap), so both the numerator E and the denominator D are already complete on each
  // rank. An all_reduce here would double-count E by comm.size() (a latent bug invisible at -np 1; it
  // doubled the energy at -np 2 while the matching un-reduced D left s3 != s1 == NOMSD).
  if constexpr (MEM == HOST_MEMORY)
    for (int w = 0; w < nwalk; ++w)
      E(w, nda::range::all) /= D(w);
  else
  {
#if defined(ENABLE_DEVICE)
    kernels::device::row_divide(D, E);
#endif
  }

  // reduce_inner_cross_dm fills Ov with the LINEAR effective overlap (1/P) sum_p <psi_p|phi_w>; the
  // OVLP property convention (matching NOMSD::Energy) is the LOG overlap, so convert back here.
  if constexpr (MEM == HOST_MEMORY)
    for (int w = 0; w < nwalk; ++w)
      Ov(w) = std::log(Ov(w));
  else
  {
#if defined(ENABLE_DEVICE)
    kernels::device::elementwise_log(Ov);
#endif
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class Mat, class TVec>
void StochasticWfn<MEM, devPsiT>::measure_energy(WlkSet& wset, Mat&& E, TVec&& Ov, int nt)
{
  // Average local energy over inner_n_measure_samples pool advances at fixed walkers:
  // E = (1/nm) sum_j Energy_j, where each Energy_j is one replica's per-walker ratio estimate. The pool
  // advances before EVERY replica including the first, and the advance is KEPT -- see
  // measure_advances_pool() for why both of those match hafqmc rather than the old nm-gated behaviour.
  // Falls through to plain Energy only when there is no live chain to advance (static / free projection).
  if (not measure_advances_pool())
  {
    Energy(wset, std::forward<Mat>(E), std::forward<TVec>(Ov), nt);
    return;
  }

  const int nwalk = int(wset.size());
  const int nm    = inner_n_measure_samples_;

  memory::buffered_array<MEM, ComplexType, 2> E_j(nwalk, 3);
  memory::buffered_array<MEM, ComplexType, 1> Ov_j(nwalk);
  // Device path reuses the existing stochastic reduction kernels rather than adding new ones:
  // row_accumulate(ones, E_j, E) is the unweighted E += E_j, and row_divide(nm, E) is the 1/nm scale.
  memory::buffered_array<MEM, ComplexType, 1> ones(nwalk, ComplexType(1.0));
  memory::buffered_array<MEM, ComplexType, 1> nm_vec(nwalk, ComplexType(double(nm)));
  E()  = ComplexType(0.0);
  Ov() = ComplexType(0.0);

  for (int j = 0; j < nm; ++j)
  {
    // Advance the pool before every replica, including the first.
    advance_measure_pool(wset);
    E_j()  = ComplexType(0.0);
    Ov_j() = ComplexType(0.0);
    Energy(wset, E_j, Ov_j, nt);
    if constexpr (MEM == HOST_MEMORY)
    {
      for (int w = 0; w < nwalk; ++w)
        E(w, nda::range::all) += E_j(w, nda::range::all);
    }
    else
    {
#if defined(ENABLE_DEVICE)
      kernels::device::row_accumulate(ones, E_j, E);
#endif
    }
    // Ov_j is DISCARDED on purpose -- see the OVLP note after the loop.
  }

  if constexpr (MEM == HOST_MEMORY)
  {
    const ComplexType inv_nm(1.0 / double(nm));
    for (int w = 0; w < nwalk; ++w)
      E(w, nda::range::all) *= inv_nm;
  }
  else
  {
#if defined(ENABLE_DEVICE)
    kernels::device::row_divide(nm_vec, E);
#endif
  }

  // Return the walker's stored OVLP so EnergyEstimator's exp(ovlp - OVLP) factor stays 1.
  // Replica overlaps are intentionally discarded; see StochasticWfn.hpp.
  if constexpr (MEM == HOST_MEMORY)
    wset.getProperty(OVLP, Ov);
  else
  {
#if defined(ENABLE_DEVICE)
    wset.getProperty(OVLP, Ov);
#endif
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::Energy(WlkSet& wset)
{
  if (at_delegate_limit())
  {
    nomsd_.Energy(wset);
    return;
  }
  // Off-anchor: delegates to the device-safe Energy(wset, eloc, ovlp) reduction (static-anchor ported;
  // dynamic inner_nsteps>0 is forbidden at construction on device).
  int nw = wset.size();
  memory::buffered_array<MEM, ComplexType, 1> ovlp(nw, ComplexType(0.0));
  memory::buffered_array<MEM, ComplexType, 2> eloc(nw, 3);
  Energy(wset, eloc, ovlp);
  wset.setProperty(OVLP, ovlp);
  wset.setProperty(E1_, eloc(nda::range::all, 0));
  wset.setProperty(EXX_, eloc(nda::range::all, 1));
  wset.setProperty(EJ_, eloc(nda::range::all, 2));
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, nda::MemoryMatrix MatA>
void StochasticWfn<MEM, devPsiT>::vbias(WlkSet& wset, MatA&& v, double dt, int nt)
{
  if (at_delegate_limit())
  {
    nomsd_.vbias(wset, std::forward<MatA>(v), dt, nt);
    return;
  }
  // Off-anchor: device-safe via the ported MixedDensityMatrix_for_vbias + device vbias_from_G
  // (static-anchor; dynamic inner_nsteps>0 is forbidden at construction on device).
  const int nwalk = wset.size();
  const bool full = (inner_nsteps_ > 0);
  // Same capability gate as vMF, for the same reason: once the inner ensemble has moved off the anchor
  // the force bias is built from an un-rotated G, which not every factorization can contract.
  utils::check(not full || nomsd_.has_fullG_vbias(),
               "StochasticWfn::vbias: a dynamic inner ensemble (inner_nsteps > 0) builds an un-rotated "
               "full G, but this Hamiltonian operator implements vbias only for a half-rotated compact "
               "G. Supported: Real3IndexFactorization (molecules) and ModelHamOps (lattice/Hubbard).");
  const int Gsize = dm_size(full);
  memory::buffered_array<MEM, ComplexType, 2> G(nwalk, Gsize);
  MixedDensityMatrix_for_vbias(wset, G);
  v() = ComplexType(0.0);
  // vbias_from_G -> HamOp.vbias dispatches on the G layout: a compact G when the inner ensemble is
  // at the anchor (inner_nsteps == 0) and a full NMO*NMO G once it has moved off (inner_nsteps > 0),
  // so a single seam covers both. (full is still used above to size G via dm_size.)
  nomsd_.vbias_from_G(G, std::forward<MatA>(v), dt);

  // SAFIRE_DUMP_VBIAS: dump walker-0 phi and force bias for offline comparison. First 32 calls.
  if constexpr (MEM == HOST_MEMORY)
  {
    if (want_vbias_dump() && vbias_dump_call_ < 32 && nwalk > 0)
    {
      auto all                       = nda::range::all;
      const long rows                = wset.SlaterMatrices(Alpha).extent(1);
      const long naea                = wset.SlaterMatrices(Alpha).extent(2);
      nda::array<ComplexType, 2> phi = wset.SlaterMatrices(Alpha)(0, all, all);
      nda::array<ComplexType, 1> vb0(v.extent(1));
      for (long m = 0; m < v.extent(1); ++m)
        vb0(m) = v(0, m);
      dump_vbias_row(vbias_dump_call_, int(rows), int(naea), phi.data(), int(v.extent(1)), vb0.data());
    }
    ++vbias_dump_call_;
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::begin_inner_step(WlkSet& wset)
{
  inner_step_pending_ = true;
  // A forward step closes the current BP window: invalidate any cached BP reference draw so the next
  // back-propagation block draws a fresh free-projection ensemble (and so getReferences sees the forward
  // ensemble, not a stale draw, after a resample).
  bp_refs_drawn_ = false;
  // Persistent chains: this is the one seam with NON-const access to the outer walker set (whose
  // buffer holds the chain fields), so ALL chain mutation happens here -- prime on first use, then
  // inner_sample_update_steps_ MH sweeps targeting the CURRENT (old) walkers. The updated pool serves every
  // reduction of this step (latch cleared below), so the step's overlap RATIO new/old shares one
  // ensemble (Eq. 25). Runs on every rank at every step -- uniform control flow, no communication.
  // Persistent field-chain pool update (device-ported: host-RNG hybrid chain MCMC).
  if (inner_persistence())
  {
    update_persistent_chain_pool(wset);
    inner_step_pending_ = false;
  }
  // Leapfrog: refresh the stored OVLP = <Psi_T|phi> against the ensemble tied to the current (old)
  // walker phi, so the post-propagation Log_Overlap sees the SAME ensemble and the step's overlap RATIO
  // new/old is exactly Eq. 25 with N(phi) cancelling. Device-safe: Log_Overlap is device-ported.
  if (inner_leapfrog() && inner_conditioning())
  {
    // NO POOL-CHANGE HANDOFF. The pool advanced above while the walker did not, so the stored OVLP jumps
    // by r = O_pool_new(phi)/O_pool_old(phi). We simply re-measure and carry on -- WEIGHT is not charged
    // for it.
    //
    // 🔴 THIS IS A DELIBERATE, DOCUMENTED DIVERGENCE FROM hafqmc, and the only one in the sampler. hafqmc
    // charges max(0, cos arg r) at its own pool seam (trial/stochastic_runtime_methods.py:
    // `handoff = _phaseless_from_ratio(sign_ratio)`). We do not, because in exact arithmetic there is
    // nothing there to charge:
    //
    //   The only uncancelled piece of a pool change is N(phi_old)/N(phi_new), a ratio of
    //   conditioned-density normalizations N(phi_c) = integral dY p_T(Y) |<psi(Y)|phi_c>|. That is REAL
    //   and POSITIVE, hence PHASE-FREE. So arg r is pure finite-P estimator noise, and since
    //   max(0, cos theta) <= 1 with equality only at theta = 0, charging it is a strictly-decaying,
    //   physics-free penalty applied every step -- worst at small P and poor trials, i.e. exactly where
    //   the method is already struggling.
    //
    // The piece that DOES have a true counterpart is the magnitude |r|, and both codes independently
    // rejected it: SAFIRE measured it as catastrophic, and hafqmc's magnitude-carrying line is COMMENTED
    // OUT in its source. So hafqmc's phase-only handoff is not a derivation either -- it is what was left
    // after the principled version proved unusable. Matching a stabilised remnant is not the same as
    // matching the method, which is why this seam is where we stop matching.
    //
      // MEASURED (N2 equilibrium, P=8, 30 walkers, inner_sample_update_steps=1, tau in (5,20], 9 seeds, paired):
    // enabling the handoff moved the energy -2.44 +/- 1.67 mHa (1.46 sigma -- NOT significant) and total
    // walker weight over the window from 1.005 to 0.991, i.e. the predicted decay showed up while the
    // energy shift did not resolve. ⚠️ N2-equilibrium is the EASIEST system here and equil=1 is not the
    // production setting; the penalty should grow with pool-change size, smaller P and poorer trials, so
    // this null must NOT be generalised (invariant #16). If a per-system probe ever shows the handoff
    // matters, revisit -- but restore |r| or nothing, not the phase-only remnant.
    Log_Overlap(wset);
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::permute_inner_blocks_after_pop(const WlkSet& wset)
{
  // Only conditioned dynamic trials carry a slot-major (q = ip*nw + w) inner ensemble whose block w is
  // conditioned on outer walker phi_w; static / free-projection / delegate modes have nothing to realign.
  // The permutation contract is: PERMUTE the stored inner_cond_mag_ values, never recompute them against
  // the post-pop wset. That is what keeps EnergyEstimator's deno_real == 1.
  if (not(inner_conditioning()))
    return;
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    return;

  // Device-safe: the non-persistent conditioned permute is getProperty(SLOT_LINEAGE)->host + host parent +
  // device slice-copy gather + host inner_cond_mag_ permute. The persistent branch below uses the (still
  // CPU-only) rebuild_inner_dets_from_chain_fields, but persistent trials are blocked at construction on
  // device, so that branch is unreachable on GPU.
  const int nw          = int(wset.size());
  const int P           = inner_n_samples_;

  // Persistent chains: the chain fields live inside walker_buffer, so branch()'s row copies and the
  // load-balance payload have ALREADY moved them with their walkers -- clones inherited their parent's
  // chains and cross-rank arrivals brought theirs along. The cached DETERMINANTS are simply out of
  // date and are always exactly recoverable: rebuild_inner_dets_from_chain_fields reads whatever
  // fields are now in each slot and reconstructs psi_q from them, correct for both local clones and
  // cross-rank migrants (no lineage needed -- the fields already carry the right lineage).
  //
  // inner_cond_mag_, however, is a StochasticWfn-owned array, NOT part of walker_buffer -- it does
  // NOT ride along with branch()/load-balance the way the fields do. Its value at slot w means
  // "|<psi_w|phi_cond>| for the walker this chain was equilibrated against at the last
  // begin_inner_step", and that meaning must be preserved across a pop event by PERMUTING existing
  // values (mirroring the non-persistent path below), never by recomputing against the wset visible
  // here -- which is the walker AFTER this step's propagation and pop control, not phi_cond. Recomputing
  // against the wrong reference desyncs the value the leapfrog "old" overlap was already stored with
  // (set earlier this same step, in begin_inner_step, against the true phi_cond) from what a later
  // reduction in this same step (e.g. the estimator's Energy() call) would recompute -- breaking the
  // Permute stored magnitudes; never recompute against the post-pop walker (breaks Eq. 25 consistency).
  if (inner_persistence())
  {
    if (not inner_chains_primed_)
      return; // chains not started yet (no pop event can precede the first propagation step)
    rebuild_inner_dets_from_chain_fields(wset);
    inner_dets_stale_ = false;
    if (inner_leapfrog() && inner_cond_mag_.size() == long(nw) * P)
    {
      // Per-slot realignment of the leapfrog magnitudes. A locally-sourced slot (parent in [0,nw))
      // PERMUTES its old |<psi|phi_cond>| -- exact, and consistent with the stored OVLP that rode the
      // same branch() row copy. A cross-rank arrival (SLOT_LINEAGE sentinel -1) has no exact value:
      // phi_cond was the OLD walker on the sending rank and is not shipped (only the current walker
      // and the chain fields are), so its true magnitude cannot be reconstructed here. For those slots
      // ONLY we approximate with a recompute against the current wset (a bounded, one-measurement
      // desync from their stored OVLP); every locally-sourced slot on the rank stays exact. The full
      // recompute is done once into scratch and only the foreign columns are taken from it.
      nda::array<int, 1> parent(nw);
      bool any_foreign = false;
      {
        nda::array<ComplexType, 1> lin(nw);
        wset.getProperty(SLOT_LINEAGE, lin);
        for (int w = 0; w < nw; ++w)
        {
          const int s = int(std::lround(real(lin(w)))); // sentinel -1 rounds to -1, not 0
          parent(w)   = s;
          if (s < 0 || s >= nw)
            any_foreign = true;
        }
      }
      nda::array<RealType, 1> old_mag(inner_cond_mag_);
      nda::array<RealType, 1> recomputed;
      if (any_foreign)
      {
        recomputed = nda::array<RealType, 1>(long(nw) * P);
        cross_overlap_magnitudes(wset, *inner_ensemble_.wset, recomputed);
      }
      for (int w = 0; w < nw; ++w)
      {
        const int s        = parent(w);
        const bool local   = (s >= 0 && s < nw);
        for (int ip = 0; ip < P; ++ip)
          inner_cond_mag_(long(ip) * nw + w) =
              local ? old_mag(long(ip) * nw + s) : recomputed(long(ip) * nw + w);
      }
    }
    return;
  }

  // NOTE: there is no `else` here. The early return at the top of this function excludes Static and
  // Free (neither carries slot-conditioned inner blocks), so Conditioned is the only mode that reaches
  // this far -- and it always returns above. The non-persistent conditioned permute that used to follow
  // was reachable only with inner_persistence = false, which the input layer can no longer express.
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::conditioned_resample(const WlkSet& wset)
{
  if (inner_conditioning())
  {
    const int nw = int(wset.size());
    // Persistent chains, once live, are advanced ONLY in begin_inner_step (the non-const seam that can
    // write the chain fields in the outer walker buffer). A reduction's job here is repair, not
    // sampling: rebuild the cached determinants from the fields when the pool storage was reused (the
    // BP reference draw resizes it to P) or a pop event flagged them stale. Rank-local and read-only
    // on the outer walker set.
    // (Enclosing branch is inner_conditioning(), i.e. inner_persistence() -- so the
    // only question left here is whether the chains have been primed yet.)
    if (inner_chains_primed_)
    {
      if (inner_dets_stale_ || inner_ensemble_.wset->size() != long(nw) * inner_n_samples_)
      {
        rebuild_inner_dets_from_chain_fields(wset);
        inner_dets_stale_ = false;
        if (inner_leapfrog())
          compute_inner_cond_mag(wset); // |<psi_q|phi_w^cond>| for the leapfrog reweighting (Eq. 25)
      }
      return;
    }
    // Resample when the per-step latch is armed (the first reduction of an outer step owns the
    // resample; later reductions in the same step reuse the ensemble), OR when the ensemble is not yet
    // sized/conditioned for the current outer-walker count (bootstrap: priming overlap/energy calls
    // before the propagator arms the latch, and any change in the outer walker count). Otherwise the
    // ensemble is already conditioned for this configuration -- reuse it.
    //
    // The size check alone is NOT a reliable bootstrap signal at nw == 1: initialize_inner_walkers sizes
    // the freshly-constructed ensemble to inner_n_samples_ (= P), which coincidentally already equals
    // nw*P when nw == 1, so an un-conditioned ensemble is indistinguishable from a resampled one by
    // size alone. A driver's pre-loop initial-energy call (Energy/Log_Overlap before the first
    // begin_inner_step) hits exactly this case with a single outer walker per rank and would leave
    // inner_cond_mag_ unsized -> the leapfrog check below aborts. Before the chains have started
    // (begin_inner_step not reached), that pre-loop call lands here and takes the force-biased resample
    // below for its one-off diagnostic ensemble -- chains are untouched, and the estimators reweight
    // that ensemble by exp(logsw) because inner_chains_primed_ is still false (see Log_Overlap).
    const bool need_resample =
        inner_step_pending_ || (not inner_chains_primed_) ||
        (inner_ensemble_.wset->size() != long(nw) * inner_n_samples_);
    if (not need_resample)
      return;
    // Importance-sample the inner fields conditioned on each outer walker phi_w (Eq. 23 of
    // arXiv:2505.18519). The inner trial IS the anchor phi_T, so the inner NOMSD's own mixed DM + vbias
    // on the OUTER walker set yields the conditioning force bias
    //   x_bar(phi_w) = sqrt(dt) * L^var . <phi_T|c+c|phi_w> / <phi_T|phi_w>
    // (the sqrt(dt)*[2 for CLOSED] prefactor and the overlap normalization come from HamOp.vbias /
    // MixedDensityMatrix, matching the field-shift convention assemble_X expects). No bespoke contraction.
    const int nc  = inner_nomsd().dm_size(false); // compact cross-DM size (inner trial is single-det)
    const int nCV = inner_nomsd().number_of_cholesky_vectors();
    memory::buffered_array<MEM, ComplexType, 2> Gcross(nw, nc);
    memory::buffered_array<MEM, ComplexType, 1> ovcross(nw);
    Gcross()  = ComplexType(0.0);
    ovcross() = ComplexType(0.0);
    inner_nomsd().MixedDensityMatrix(wset, Gcross, ovcross, true);
    memory::array<MEM, ComplexType, 2> X_bias(nw, nCV);
    X_bias() = ComplexType(0.0);
    inner_nomsd().vbias_from_G(Gcross, X_bias, inner_timestep_);
    advance_inner_ensemble_conditioned(X_bias, nw);
    if (inner_leapfrog())
      compute_inner_cond_mag(wset); // |<psi_q|phi_w^cond>| for the leapfrog overlap reweighting (Eq. 25)
  }
  else
  {
    // Walker-independent free-projection resample (honors the latch + static no-op).
    maybe_advance_inner_ensemble();
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::compute_inner_cond_mag(const WlkSet& wset)
{
  // |<psi_q | phi_w^cond>| for each inner walker q = ip*nw + w (slot-major), where phi_w^cond is the
  // outer walker its block was conditioned on in the resample just completed. The leapfrog overlap
  // (Log_Overlap below) divides each per-sample term by this, so old_ovlp = Sum_p S_p and the step
  // ratio new/old is exactly Eq. 25 of arXiv:2505.18519 (N(phi) cancels). Same det(A^dag B) /
  // CLOSED-doubling convention as the Log_Overlap reduction. Replicated across ranks (cheap; the
  // FairDivided Log_Overlap reads it per pair). CLOSED-only in practice (leapfrog gate), beta included
  // for completeness. The magnitude loop is shared with the Metropolis accept/reject via
  // cross_overlap_magnitudes; this method just sizes the member and delegates.
  inner_cond_mag_ = nda::array<RealType, 1>(long(wset.size()) * inner_n_samples_);
  cross_overlap_magnitudes(wset, *inner_ensemble_.wset, inner_cond_mag_);
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::cross_overlap_magnitudes(const WlkSet& wset, WalkerSet<MEM>& inner,
                                                           nda::array<RealType, 1>& mag)
{
  const int nw          = int(wset.size());
  const int P           = inner_n_samples_;
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  auto all              = nda::range::all;
  utils::check(mag.size() == long(nw) * P, "cross_overlap_magnitudes: mag must be sized nw*P.");
  utils::check(inner.size() == long(nw) * P, "cross_overlap_magnitudes: inner must be slot-major nw*P.");
  memory::buffered_array<MEM, ComplexType, 1> logov(nw);
  memory::buffered_array<MEM, ComplexType, 1> logov_b(nw);
  for (int ip = 0; ip < P; ++ip)
  {
    auto inner_a = inner.SlaterMatrices(Alpha)(nda::range(long(ip) * nw, long(ip + 1) * nw), all, all);
    logov() = ComplexType(0.0);
    det_ops::Log_Overlap(inner_a, wset.SlaterMatrices(Alpha), logov);
    if (wt == CLOSED)
      nda::tensor::scale(ComplexType(2.0), logov);
    else if (wt == COLLINEAR)
    {
      auto inner_b = inner.SlaterMatrices(Beta)(nda::range(long(ip) * nw, long(ip + 1) * nw), all, all);
      logov_b()    = ComplexType(0.0);
      det_ops::Log_Overlap(inner_b, wset.SlaterMatrices(Beta), logov_b);
    }
    // mag is a host array; the per-slot log-overlaps are small ([nw]). Pull them to host (a no-op copy on
    // HOST_MEMORY) and finish the |exp(.)| on host -- device-safe and avoids a bespoke magnitude kernel.
    auto logov_h = nda::to_host(logov);
    nda::array<ComplexType, 1> logov_b_h;
    if (wt == COLLINEAR)
      logov_b_h = nda::to_host(logov_b);
    for (int w = 0; w < nw; ++w)
    {
      ComplexType lo = logov_h(w);
      if (wt == COLLINEAR)
        lo += logov_b_h(w);
      mag(long(ip) * nw + w) = std::abs(std::exp(lo));
    }
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class TVecD, class TVecOv, class Accumulate>
void StochasticWfn<MEM, devPsiT>::reduce_inner_cross_dm(const WlkSet& wset,
                                                         bool compact,
                                                         int Gsize,
                                                         TVecD&& D,
                                                         TVecOv&& Ov,
                                                         Accumulate&& accumulate)
{
  memory::check_memory_space<MEM>(D, Ov);
  if (at_delegate_limit())
    APP_ABORT("Error in StochasticWfn::reduce_inner_cross_dm: called at delegate limit "
              "(inner_n_samples=1, inner_nsteps=0); use nomsd_ reductions instead.");
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::reduce_inner_cross_dm: inner walkers not initialized.");
  conditioned_resample(wset);

  WalkerSet<MEM>& inner  = *inner_ensemble_.wset;
  const int nwalk        = wset.size();
  // With conditioning, the inner ensemble is block-structured (nwalk*P walkers, slot-major index q =
  // ip*nwalk + w, block w conditioned on outer walker phi_w). The loop runs over the P per-walker samples;
  // slot ip pairs its nwalk inner walkers diagonally with the nwalk outer walkers via the batched-
  // reference MixedDensityMatrix. Without conditioning the ensemble is P shared walkers, each paired
  // against all outer walkers with a single reference.
  const bool conditioned = (inner_conditioning());
  // Leapfrog: weight each sample by the GENERALIZED importance weight w_p = <psi_p|chi> / |<psi_p|phi_cond>|   (phi_cond = the walker the ensemble was conditioned on)
  // rather than the phase S_p = <psi_p|chi>/|<psi_p|chi>|. This is the exact Eq. 27 estimator when the
  // scored walker chi differs from phi_cond (measurement Energy after propagation, and local-energy mode
  // step-5) -- the samples come from P(.;phi_cond), so the reweighting divides by the SAMPLING density's
  // magnitude. At the top of the step chi == phi_cond, so w_p == S_p and the force-bias DM / conditioned
  // sampling path are unchanged. |<psi_p|phi_cond>| is inner_cond_mag_, set at the conditioned resample.
  const bool leapfrog    = (conditioned && inner_leapfrog());
  const int P            = (conditioned ? inner_n_samples_ : int(inner.size()));
  utils::check(P >= 1, "inner ensemble must be non-empty");
  if (conditioned)
    utils::check(inner.size() == long(nwalk) * P, "conditioned inner ensemble size mismatch (expect nwalk*P)");
  if (leapfrog)
    utils::check(inner_cond_mag_.size() == long(nwalk) * P,
                 "leapfrog inner_cond_mag_ not sized -- conditioned resample must run first");
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  const ComplexType zero(0.0);
  const ComplexType inv_P(1.0 / static_cast<double>(P), 0.0);
  const int nel         = (wt == COLLINEAR ? nup + ndown : nup);
  const int nspin       = (wt == COLLINEAR ? 2 : 1);
  const int npol        = (wt == NONCOLLINEAR ? 2 : 1);
  auto all              = nda::range::all;

  utils::check(Gsize == dm_size(not compact), "Gsize mismatch");
  utils::check(D.size() == nwalk && Ov.size() == nwalk, "Size mismatch");

  memory::buffered_array<MEM, ComplexType, 2> Gp(nwalk, Gsize);
  memory::buffered_array<MEM, ComplexType, 1> ov_(nwalk, zero);
  memory::buffered_array<MEM, ComplexType, 1> Sp(nwalk, zero);

  D()  = zero;
  Ov() = zero;

  memory::array<MEM, ComplexType, 2> ref_alpha(NMO, nup);
  memory::array<MEM, ComplexType, 2> ref_beta(NMO, ndown);

  for (int ip = 0; ip < P; ++ip)
  {
    Gp()  = zero;
    ov_() = zero;
    if (conditioned)
    {
      // slot ip: inner walkers [ip*nwalk, (ip+1)*nwalk) paired element-wise with the outer walkers.
      auto inner_a = inner.SlaterMatrices(Alpha)(nda::range(long(ip) * nwalk, long(ip + 1) * nwalk), all, all);
      if (compact)
      {
        auto G3d = nda::reshape(Gp, std::array<long, 3>{nwalk, nel, npol * NMO});
        det_ops::MixedDensityMatrix(inner_a, wset.SlaterMatrices(Alpha), G3d(all, nda::range(nup), all), ov_,
                                    compact);
        if (wt == CLOSED)
          nda::tensor::scale(ComplexType(2.0), ov_);
        else if (wt == COLLINEAR)
        {
          auto inner_b = inner.SlaterMatrices(Beta)(nda::range(long(ip) * nwalk, long(ip + 1) * nwalk), all, all);
          det_ops::MixedDensityMatrix(inner_b, wset.SlaterMatrices(Beta), G3d(all, nda::range(nup, nel), all), ov_,
                                      compact);
        }
      }
      else
      {
        auto G3d = nda::reshape(Gp, std::array<long, 3>{nwalk, nspin * npol * NMO, npol * NMO});
        det_ops::MixedDensityMatrix(inner_a, wset.SlaterMatrices(Alpha), G3d(all, nda::range(npol * NMO), all),
                                    ov_, compact);
        if (wt == CLOSED)
          nda::tensor::scale(ComplexType(2.0), ov_);
        else if (wt == COLLINEAR)
        {
          auto inner_b = inner.SlaterMatrices(Beta)(nda::range(long(ip) * nwalk, long(ip + 1) * nwalk), all, all);
          det_ops::MixedDensityMatrix(inner_b, wset.SlaterMatrices(Beta),
                                      G3d(all, nda::range(npol * NMO, nspin * npol * NMO), all), ov_, compact);
        }
      }
    }
    else if (compact)
    {
      ref_alpha() = inner.SlaterMatrices(Alpha)(ip, all, all);
      auto G3d = nda::reshape(Gp, std::array<long, 3>{nwalk, nel, npol * NMO});
      det_ops::MixedDensityMatrix(ref_alpha, wset.SlaterMatrices(Alpha), G3d(all, nda::range(nup), all), ov_,
                                  compact, false);
      if (wt == CLOSED)
        nda::tensor::scale(ComplexType(2.0), ov_);
      else if (wt == COLLINEAR)
      {
        ref_beta() = inner.SlaterMatrices(Beta)(ip, all, all);
        det_ops::MixedDensityMatrix(ref_beta, wset.SlaterMatrices(Beta), G3d(all, nda::range(nup, nel), all), ov_,
                                    compact, false);
      }
    }
    else
    {
      ref_alpha() = inner.SlaterMatrices(Alpha)(ip, all, all);
      auto G3d = nda::reshape(Gp, std::array<long, 3>{nwalk, nspin * npol * NMO, npol * NMO});
      det_ops::MixedDensityMatrix(ref_alpha, wset.SlaterMatrices(Alpha), G3d(all, nda::range(npol * NMO), all),
                                  ov_, compact, false);
      if (wt == CLOSED)
        nda::tensor::scale(ComplexType(2.0), ov_);
      else if (wt == COLLINEAR)
      {
        ref_beta() = inner.SlaterMatrices(Beta)(ip, all, all);
        det_ops::MixedDensityMatrix(ref_beta, wset.SlaterMatrices(Beta),
                                    G3d(all, nda::range(npol * NMO, nspin * npol * NMO), all), ov_, compact,
                                    false);
      }
    }

    if constexpr (MEM == HOST_MEMORY)
    {
    for (int w = 0; w < nwalk; ++w)
    {
      ComplexType lin_ov = std::exp(ov_(w));
      ComplexType s;
      if (leapfrog)
      {
        const long q = long(ip) * nwalk + w;
        if ((not inner_chains_primed_) && inner_logsw_.size() == inner_cond_mag_.size())
          s = std::exp(inner_logsw_(q)) * lin_ov;
        else
        {
          double magc = double(inner_cond_mag_(q));
          s = (magc > 0.0) ? (lin_ov / ComplexType(magc, 0.0)) : zero;
        }
      }
      else
      {
        double mag = std::abs(lin_ov);
        s          = (mag > 0.0) ? (lin_ov / ComplexType(mag, 0.0)) : zero;
      }
      Sp(w) = s;
      Ov(w) = Ov(w) + (leapfrog ? s : (inv_P * lin_ov));
      D(w)  = D(w) + s;
    }
    }
    else
    {
#if defined(ENABLE_DEVICE)
      if (not leapfrog)
      {
        // Common path: one fused kernel does Sp/Ov/D per walker (phase reduction).
        kernels::device::inner_scalar_reduce(ov_, Sp, Ov, D, 1.0 / static_cast<double>(P));
      }
      else
      {
        // Leapfrog reweight (by the host inner_cond_mag_) is small per-walker scalar work over [nwalk];
        // do it on host (ov_ pulled down, results pushed back). Correctness-first; this mode is not
        // perf-critical (the leapfrog tests use small P).
        auto ovh = nda::to_host(ov_);
        nda::array<ComplexType, 1> Sp_h(nwalk);
        auto Ov_h = nda::to_host(Ov);
        auto D_h  = nda::to_host(D);
        for (int w = 0; w < nwalk; ++w)
        {
          ComplexType lin_ov = std::exp(ovh(w));
          ComplexType s;
          if (leapfrog)
          {
            const long q = long(ip) * nwalk + w;
            if ((not inner_chains_primed_) && inner_logsw_.size() == inner_cond_mag_.size())
              s = std::exp(inner_logsw_(q)) * lin_ov;
            else
            {
              double magc = double(inner_cond_mag_(q));
              s = (magc > 0.0) ? (lin_ov / ComplexType(magc, 0.0)) : zero;
            }
          }
          else
          {
            double mag = std::abs(lin_ov);
            s          = (mag > 0.0) ? (lin_ov / ComplexType(mag, 0.0)) : zero;
          }
          Sp_h(w) = s;
          Ov_h(w) += leapfrog ? s : (inv_P * lin_ov);
          D_h(w) += s;
        }
        Sp() = Sp_h(); // host -> device
        Ov() = Ov_h();
        D()  = D_h();
      }
#endif
    }
    accumulate(Gp, ov_, Sp, ip, 0, Gsize);
    mpi_->comm.barrier();
  }

}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class MatG>
void StochasticWfn<MEM, devPsiT>::MixedDensityMatrix_for_vbias(const WlkSet& wset, MatG&& G)
{
  if (at_delegate_limit())
  {
    nomsd_.MixedDensityMatrix(wset, std::forward<MatG>(G), compact_G_for_vbias());
    return;
  }
  memory::check_memory_space<MEM>(G);
  const int nwalk       = wset.size();
  const ComplexType zero(0.0);
  const bool full       = (inner_nsteps_ > 0);
  const bool compact    = full ? false : compact_G_for_vbias();
  const int Gsize       = full ? dm_size(true) : dm_size(not compact);

  utils::check(G.shape() == std::array<long, 2>{nwalk, Gsize}, "Size mismatch");

  memory::buffered_array<MEM, ComplexType, 2> Gnum(nwalk, Gsize);
  Gnum() = zero;
  memory::buffered_array<MEM, ComplexType, 1> D(nwalk, zero);
  memory::buffered_array<MEM, ComplexType, 1> Ov(nwalk, zero);

  reduce_inner_cross_dm(
      wset, compact, Gsize, D, Ov,
      [&](auto& Gp, auto& /*ov_*/, auto& Sp, int /*ip*/, int /*r0*/, int /*rN*/) {
        if constexpr (MEM == HOST_MEMORY)
          for (int w = 0; w < nwalk; ++w)
            Gnum(w, nda::range::all) += Sp(w) * Gp(w, nda::range::all);
        else
        {
#if defined(ENABLE_DEVICE)
          kernels::device::row_accumulate(Sp, Gp, Gnum);
#endif
        }
      });

  if constexpr (MEM == HOST_MEMORY)
    for (int w = 0; w < nwalk; ++w)
      Gnum(w, nda::range::all) /= D(w);
  else
  {
#if defined(ENABLE_DEVICE)
    kernels::device::row_divide(D, Gnum);
#endif
  }
  G() = Gnum();
}

// Stochastic mixed density matrix for observable evaluation. Same inner-ensemble reduction as
// ensemble reduction as MixedDensityMatrix_for_vbias (estimator 3 of arXiv:2505.18519,
// G[w] = sum_p w_p G_{p,w} / sum_p w_p with the 1/P -> S_p -> generalized weight progression), but
// returned in the caller's observable layout and with the LOG overlap NOMSD's observable DM reports.
template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class MatG, class TVec>
void StochasticWfn<MEM, devPsiT>::MixedDensityMatrix(const WlkSet& wset, MatG&& G, TVec&& Ov, bool compact)
{
  if (at_delegate_limit())
  {
    nomsd_.MixedDensityMatrix(wset, std::forward<MatG>(G), std::forward<TVec>(Ov), compact);
    return;
  }
  memory::check_memory_space<MEM>(G, Ov);
  const int nwalk = wset.size();
  const ComplexType zero(0.0);

  // Off the anchor (inner_nsteps > 0) each inner walker psi_p occupies a different orbital space, so its
  // per-pair COMPACT mixed DM has its nel rows in psi_p's own occupied basis -- a p-dependent basis that
  // cannot be averaged across the ensemble. Only the full NMO x NMO layout is basis-independent there.
  // At the static limit every psi_p == anchor, so the compact layout is well-defined (anchor basis) and
  // matches NOMSD. This mirrors MixedDensityMatrix_for_vbias forcing the full layout once inner_nsteps>0.
  utils::check(not(compact and inner_nsteps_ > 0),
               "StochasticWfn::MixedDensityMatrix: a compact observable density matrix is only "
               "supported for the static inner ensemble (inner_nsteps == 0); request the full "
               "(compact == false) layout for a dynamic ensemble.");

  const int Gsize = dm_size(not compact);
  utils::check(G.shape() == std::array<long, 2>{nwalk, Gsize}, "Size mismatch");
  utils::check(Ov.size() == nwalk, "Size mismatch");

  memory::buffered_array<MEM, ComplexType, 2> Gnum(nwalk, Gsize);
  Gnum() = zero;
  memory::buffered_array<MEM, ComplexType, 1> D(nwalk, zero);
  Ov() = zero;

  reduce_inner_cross_dm(
      wset, compact, Gsize, D, Ov,
      [&](auto& Gp, auto& /*ov_*/, auto& Sp, int /*ip*/, int /*r0*/, int /*rN*/) {
        if constexpr (MEM == HOST_MEMORY)
          for (int w = 0; w < nwalk; ++w)
            Gnum(w, nda::range::all) += Sp(w) * Gp(w, nda::range::all);
        else
        {
#if defined(ENABLE_DEVICE)
          kernels::device::row_accumulate(Sp, Gp, Gnum);
#endif
        }
      });

  if constexpr (MEM == HOST_MEMORY)
    for (int w = 0; w < nwalk; ++w)
      Gnum(w, nda::range::all) /= D(w);
  else
  {
#if defined(ENABLE_DEVICE)
    kernels::device::row_divide(D, Gnum);
#endif
  }
  G() = Gnum();

  // reduce_inner_cross_dm fills Ov with the LINEAR effective overlap (1/P) sum_p <psi_p|phi_w>; NOMSD's
  // MixedDensityMatrix returns the LOG overlap (det_ops convention, matching the OVLP property), so
  // convert back here -- exactly as the Energy / Log_Overlap overrides do.
  if constexpr (MEM == HOST_MEMORY)
    for (int w = 0; w < nwalk; ++w)
      Ov(w) = std::log(Ov(w));
  else
  {
#if defined(ENABLE_DEVICE)
    kernels::device::elementwise_log(Ov);
#endif
  }
}

// Accumulate observable contributions using the stochastic mixed Green's function. NOMSD (ndet == 1) builds the full mixed DM of its trial -- compact `DensityMatrix` against
// OrbMats(0), un-compacted via `T(OrbMats) * Gc` -- and feeds it to the observables. Here that full DM
// is instead the inner-ensemble reduction `G[w] = Σ_p w_p G_{p,w}/Σ_p w_p` (estimator 3, full layout),
// i.e. the stochastic `MixedDensityMatrix(compact = false)`, then fed to the same observable loop.
template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class Observable>
void StochasticWfn<MEM, devPsiT>::accumulate_estimators(int iav, WlkSet& wset,
    nda::MemoryVector auto const& wgt, std::vector<Observable>& properties_1body,
    std::vector<Observable>& properties, nda::MemoryArrayOfRank<4> auto* X,
    nda::MemoryArrayOfRank<4> auto* Yc, nda::MemoryArrayOfRank<4> auto* M, bool time_evolved,
    bool importanceSampling)
{
  // Delegate limit: behave exactly as NOMSD (exact for a single-determinant trial; the usual multi-
  // determinant caveat of every stochastic override applies).
  if (at_delegate_limit())
  {
    nomsd_.accumulate_estimators(iav, wset, wgt, properties_1body, properties, X, Yc, M, time_evolved,
                                 importanceSampling);
    return;
  }
  // Off-anchor: device-safe via the ported MixedDensityMatrix + device math::product (time-evolved BP
  // transform) + the NOMSD observable accumulate path (same as the [estimators] GPU tests).
  utils::check(importanceSampling, "Finish"); // mirror NOMSD: the non-importance-sampled path is unfinished

  using nda::range;
  auto all              = range::all;
  const int nwalk       = int(wset.size());
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  const int nspin       = (wt == COLLINEAR ? 2 : 1);
  const int npol        = (wt == NONCOLLINEAR ? 2 : 1);
  const ComplexType zero(0.0);

  // Stochastic full mixed Green's function, laid out [nw][nspin][npol*NMO][npol*NMO] as the observables
  // expect. dm_size(true) == nspin*npol*NMO*npol*NMO, so the 4D buffer reshapes to the [nw, Gsize] view
  // MixedDensityMatrix writes (full layout; valid for both the static and dynamic ensemble).
  const int Gsize = dm_size(true);
  memory::buffered_array<MEM, ComplexType, 4> Gfull(nwalk, nspin, npol * NMO, npol * NMO);
  memory::buffered_array<MEM, ComplexType, 1> Ov(nwalk, zero);
  {
    auto Gflat = nda::reshape(Gfull, std::array<long, 2>{nwalk, Gsize});
    MixedDensityMatrix(wset, Gflat, Ov, false);
  }

  if (time_evolved)
  {
    // Time-evolved / back-propagated observables: transform the mixed Green's function through the
    // evolved one-body operators X (-> c+) and Yc (= conj(Y), -> c) and the operator state M, exactly as
    // NOMSD's ndet==1 path does -- per spin, G[w] <- M[w] + T(X[w]) . G_full[w] . Yc[w]. The transform is
    // LINEAR in the mixed DM, so the inner-ensemble average (estimator 3) commutes with it: feeding the
    // stochastic full mixed DM is equivalent to averaging the per-inner-walker transforms. M and X/Yc are
    // trial-independent operator/walker quantities (from PropagateOperators), so M is added once.
    utils::check(X != nullptr and Yc != nullptr and M != nullptr,
                 "Error in StochasticWfn::accumulate_estimators: null X/Yc/M pointers with time_evolved.");
    const std::array<long, 4> op_shape{nwalk, nspin, npol * NMO, npol * NMO};
    utils::check(X->shape() == op_shape and Yc->shape() == op_shape and M->shape() == op_shape,
                 "Error in StochasticWfn::accumulate_estimators: X/Yc/M shape mismatch.");

    // GY[is] = G_full[is] . Yc[is]  (use the stochastic full DM before it is overwritten by M).
    memory::buffered_array<MEM, ComplexType, 4> GY(nwalk, nspin, npol * NMO, npol * NMO);
    for (int is = 0; is < nspin; ++is)
      math::product(Gfull(all, is, all, all), (*Yc)(all, is, all, all), GY(all, is, all, all));
    // G_full no longer needed; start from the operator state M and add T(X) . GY.
    Gfull() = (*M)();
    for (int is = 0; is < nspin; ++is)
      math::product<'T'>(ComplexType(1.0), (*X)(all, is, all, all), GY(all, is, all, all), ComplexType(1.0),
                         Gfull(all, is, all, all));
  }

  auto Gfull_h = nda::to_host(Gfull());
  for (auto& v : properties_1body)
    v.accumulate(iav, Gfull, Gfull_h, wgt, importanceSampling);
  for (auto& v : properties)
    v.accumulate(iav, Gfull, Gfull_h, wgt, importanceSampling);
}

// Stochastic trial mean-field one-body Green's function. This is the trial's OWN expectation
// expectation <Psi_T|c+c|Psi_T>/<Psi_T|Psi_T> (no outer walker), so it reduces the inner ensemble
// {psi_p} against ITSELF as a double sum over inner-walker pairs -- the inner-ensemble analogue of
// NOMSD's multi-determinant G_MF/vMF, with each inner walker a "determinant" of uniform weight 1/P.
// det_ops::MixedDensityMatrix returns the per-pair mixed DM ALREADY normalized by its pair overlap, so
//   G_MF = [sum_{p,q} <psi_p|psi_q> (G_{p,q})] / [sum_{p,q} <psi_p|psi_q>]
// with linear pair overlaps <psi_p|psi_q> = exp(ov_pq) supplying the weights (CLOSED doubles the alpha
// log-overlap to get the full overlap, exactly as the propagator hot-path reductions do). At the static
// limit every psi_p == anchor, so every G_{p,q} == the anchor density and the double sum collapses to
// it -- i.e. NOMSD::G_MF's ndet==1 result. Bras p are FairDivide'd across the comm (full ket batch per
// bra), then Gsum/Osum are all-reduced. Multi-rank consistency of the per-rank-decorrelated dynamic
// ensemble is part of the deferred -np>1 gate; at the static limit (and -np 1) it is exact.
//
// P is inner_n_samples_ (the walker-INDEPENDENT sample count), NOT inner.size(): `inner` MUST be a
// walker-independent P-sample ensemble (asserted below). vMF/G_MF pass either the forward ensemble when
// it is already in that form (mean_field_uses_inner_ensemble) or a dedicated free-projection scratch draw
// (mean_field_scratch_ensemble) when the forward ensemble has been expanded to the conditioned nw*P form
// -- the trial mean field has no outer-walker dependence, so a conditioned ensemble must never be summed
// here (it would carry the wrong 1/(nwalk*P)^2 weighting and an outer-walker bias).
template<MEMORY_SPACE MEM, class devPsiT>
void StochasticWfn<MEM, devPsiT>::reduce_inner_mean_field_dm(WalkerSet<MEM>& inner,
                                                             memory::buffered_array<MEM, ComplexType, 2>& Gsum)
{
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::reduce_inner_mean_field_dm: inner walkers not initialized.");
  using nda::range;
  auto all              = range::all;
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  const int nspin       = (wt == COLLINEAR ? 2 : 1);
  const int npol        = (wt == NONCOLLINEAR ? 2 : 1);
  const int P           = inner_n_samples_;
  const long full_size  = long(nspin) * npol * NMO * npol * NMO;
  const ComplexType zero(0.0);
  const double invP2    = 1.0 / (static_cast<double>(P) * static_cast<double>(P));
  utils::check(P >= 1, "inner ensemble must be non-empty");
  utils::check(int(inner.size()) == P,
               "StochasticWfn::reduce_inner_mean_field_dm: inner ensemble not in the walker-independent "
               "P-sample form (gate on mean_field_uses_inner_ensemble before calling)");
  utils::check(Gsum.shape() == std::array<long, 2>{1, full_size}, "Gsum size mismatch");

  Gsum() = zero;
  RealType Osum(0.0);

  int p0, pN;
  std::tie(p0, pN) = FairDivideBoundary(mpi_->comm.rank(), P, mpi_->comm.size());

  {
    memory::buffered_array<MEM, ComplexType, 1> ov_(P, zero);
    memory::buffered_array<MEM, ComplexType, 2> Gpq(P, full_size);
    auto Gpq3d = nda::reshape(Gpq, std::array<long, 3>{P, nspin * npol * NMO, npol * NMO});
    memory::array<MEM, ComplexType, 2> ref_alpha(npol * NMO, nup);
    memory::array<MEM, ComplexType, 2> ref_beta(npol * NMO, ndown);

    for (int p = p0; p < pN; ++p)
    {
      ov_()       = zero;
      Gpq()       = zero;
      // bra = inner walker p, ket = the whole inner ensemble (one batched MixedDensityMatrix per bra);
      // herm = false because the inner walkers are stored as Slater matrices (det_ops conjugate-
      // transposes the bra reference internally), exactly as reduce_inner_cross_dm does.
      ref_alpha() = inner.SlaterMatrices(Alpha)(p, all, all);
      det_ops::MixedDensityMatrix(ref_alpha, inner.SlaterMatrices(Alpha), Gpq3d(all, range(npol * NMO), all),
                                  ov_, false, false);
      if (wt == CLOSED)
        nda::tensor::scale(ComplexType(2.0), ov_);
      else if (wt == COLLINEAR)
      {
        ref_beta() = inner.SlaterMatrices(Beta)(p, all, all);
        det_ops::MixedDensityMatrix(ref_beta, inner.SlaterMatrices(Beta),
                                    Gpq3d(all, range(npol * NMO, nspin * npol * NMO), all), ov_, false, false);
      }
      auto ov_h = nda::to_host(ov_);
      for (int q = 0; q < P; ++q)
      {
        RealType scl = std::real(ComplexType(invP2) * std::exp(ov_h(q)));
        Osum += scl;
        // Gsum[0,:] += scl * Gpq[q,:]  (scl is a host scalar from to_host(ov_) above).
        if constexpr (MEM == HOST_MEMORY)
          Gsum(0, all) += ComplexType(scl) * Gpq(q, all);
        else
        {
#if defined(ENABLE_DEVICE)
          kernels::device::accumulate(ComplexType(scl), Gpq(q, all), Gsum(0, all));
#endif
        }
      }
    }
  }

  if (mpi_->comm.size() > 1)
  {
    mpi_->all_reduce(Gsum, std::plus<>{});
    mpi_->comm.all_reduce_in_place_n(&Osum, 1, std::plus<>{});
  }
  utils::check(std::abs(Osum) > 0.0,
               "StochasticWfn::reduce_inner_mean_field_dm: trial self-overlap vanished (orthogonal "
               "inner ensemble)");
  nda::tensor::scale(ComplexType(1.0 / Osum), Gsum);
}

// Mean-field Green's function of the FULL stochastic trial, <Psi_T|c+c|Psi_T>/<Psi_T|Psi_T>. Delegates
// to nomsd_ (the anchor mean field) ONLY at the static / P==1 delegate limit (where the trial IS the
// anchor). For a DYNAMIC trial (inner_nsteps_ > 0 && P > 1) it reduces the full-trial DM from a
// walker-INDEPENDENT P-sample draw -- the forward ensemble directly when it is already in that form
// (mean_field_uses_inner_ensemble), else a dedicated scratch free-projection draw when the forward
// ensemble has been expanded to the conditioned nw*P form (mean_field_scratch_ensemble) so the forward
// walk is left untouched. Returns the full [nspin][npol*NMO][npol*NMO] DM (same shape/return type as
// NOMSD::G_MF). Only used by the discrete/model-Hamiltonian propagator setup (continuous Cholesky
// propagators use vMF only).
template<MEMORY_SPACE MEM, class devPsiT>
auto StochasticWfn<MEM, devPsiT>::G_MF()
{
  if (not mean_field_uses_inner_ensemble() && not bp_uses_inner_ensemble())
    return nomsd_.G_MF();

  // Off-anchor: device-safe via the ported reduce_inner_mean_field_dm (static-anchor). The share_from_root
  // copy gMF() = Gv() is a device->host nda MemoryArray assignment on device builds.
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  const int nspin       = (wt == COLLINEAR ? 2 : 1);
  const int npol        = (wt == NONCOLLINEAR ? 2 : 1);
  const long full_size  = long(nspin) * npol * NMO * npol * NMO;

  // Reduce the forward ensemble when it is already in the walker-independent P-sample form; otherwise
  // draw a dedicated scratch full-trial ensemble (leaves the conditioned/persistent forward walk intact).
  WalkerSet<MEM>& mf_wset =
      mean_field_uses_inner_ensemble() ? *inner_ensemble_.wset : mean_field_scratch_ensemble();
  memory::buffered_array<MEM, ComplexType, 2> Gsum(1, full_size);
  reduce_inner_mean_field_dm(mf_wset, Gsum);
  auto Gv = nda::reshape(Gsum, std::array<long, 3>{nspin, npol * NMO, npol * NMO});
  return memory::share_from_root(*mpi_, [&] {
    nda::array<ComplexType, 3> gMF(nspin, npol * NMO, npol * NMO);
    gMF() = Gv();
    return gMF;
  });
}

// Mean-field expectation of the Cholesky/HS potentials for the FULL stochastic trial, v_n = L_n . G_MF
// (estimator 4 applied to the trial's own mean-field DM). This is the HS-contour shift subtracted in the
// propagator (X = rand + i*(vbias - vMF)); to stay consistent with the force bias and energy estimator --
// which use the full P-sample trial -- vMF MUST use the FULL trial's mean field too, NOT the anchor's.
// Under the phaseless constraint an anchor mean field can bias toward overbinding as P grows and the
// trial drifts off the anchor. vMF/G_MF therefore reduce the full trial from a scratch draw when the
// forward ensemble is in conditioned nw*P form.
//
// Delegates to nomsd_ (anchor MF) ONLY at the static / P==1 delegate limit, where the trial IS the anchor.
// For a DYNAMIC trial (inner_nsteps_ > 0 && P > 1) it reduces the full-trial mean-field DM (full layout)
// and contracts it against the True Ham via nomsd_.vbias_from_G -- the SAME full-G contraction the
// off-anchor force bias uses. Consumed once per timestep in generateP1, which runs AFTER begin_inner_step
// in Propagate: by then the ensemble is in the conditioned nw*P form, so we draw a dedicated scratch
// walker-INDEPENDENT P-sample ensemble (mean_field_scratch_ensemble) and reduce that, leaving the forward
// conditioned/persistent/leapfrog walk and its flags untouched. If the forward ensemble happens to already
// be in the walker-independent P-sample form (free-projection mode), reduce it directly.
template<MEMORY_SPACE MEM, class devPsiT>
void StochasticWfn<MEM, devPsiT>::vMF(nda::MemoryVector auto&& v, double dt)
{
  if (not mean_field_uses_inner_ensemble() && not bp_uses_inner_ensemble())
  {
    nomsd_.vMF(v, dt); // static / P==1 delegate limit: trial == anchor, so the anchor MF is exact.
    return;
  }
  // Off-anchor: device-safe via the ported reduce_inner_mean_field_dm + device vbias_from_G (static-anchor).
  //
  // The off-anchor mean field is a reduction of the inner ensemble against ITSELF, so it exists only as
  // a FULL [nspin*npol*NMO, npol*NMO] density matrix -- there is no determinant to half-rotate it
  // against. Not every Hamiltonian operator can contract that: THCOps / KPTHCOps / KP3IndexFactorization
  // implement vbias only for the half-rotated compact G (their ndet>1 branches are stubs). Gate on the
  // capability HERE, so the refusal names the actual limitation instead of surfacing as a size mismatch
  // several frames down -- and so a future operator can never quietly reinterpret the buffer instead.
  // G_MF is deliberately NOT gated: it needs no Hamiltonian operator and is correct on every family.
  utils::check(nomsd_.has_fullG_vbias(),
               "StochasticWfn::vMF: inner_n_samples > 1 needs the trial's own mean field, which is a full "
               "un-rotated G, but this Hamiltonian operator implements vbias only for a half-rotated "
               "compact G. Supported: Real3IndexFactorization (molecules) and ModelHamOps "
               "(lattice/Hubbard). Use inner_n_samples = 1 with this Hamiltonian.");
  utils::check(v.size() == number_of_cholesky_vectors(), "Size mismatch");
  utils::check(v.strides()[0] == 1, "Strides mismatch");

  const WALKER_TYPES wt = nomsd_.getWalkerType();
  const int nspin       = (wt == COLLINEAR ? 2 : 1);
  const int npol        = (wt == NONCOLLINEAR ? 2 : 1);
  const long full_size  = long(nspin) * npol * NMO * npol * NMO;

  // Reduce the forward ensemble when it is already in the walker-independent P-sample form; otherwise draw
  // a dedicated scratch full-trial ensemble (leaves the conditioned/persistent forward walk intact).
  WalkerSet<MEM>& mf_wset =
      mean_field_uses_inner_ensemble() ? *inner_ensemble_.wset : mean_field_scratch_ensemble();
  v() = ComplexType(0.0);
  memory::buffered_array<MEM, ComplexType, 2> Gsum(1, full_size);
  reduce_inner_mean_field_dm(mf_wset, Gsum);
  auto v2d = nda::reshape(v, std::array<long, 2>{1, v.size()});
  nomsd_.vbias_from_G(Gsum, v2d, dt);
}

// Back-propagation reference Slater matrices. At the OUTER-NOMSD-delegate regime (static limit / P==1) this forwards to nomsd_ (the anchor / CI expansion). For a dynamic trial
// (bp_uses_inner_ensemble()) it first DRAWS a fresh, walker-independent free-projection ensemble of P
// samples {psi_p = B_T(Y^[p])|phi_T>} (draw_bp_reference_ensemble(), decoupled from the forward inner
// ensemble -- works for free-projection AND conditioned/leapfrog forward walks), then fills the
// references from those P samples: the inner walker Slater matrix is stored as [npol*NMO, nup] (the
// transpose of NOMSD's OrbMats [nup, npol*NMO]), so the bra Refs(p,:,:) is conj(SM) directly -- a
// conjugate with NO transpose, vs NOMSD's conj+transpose of OrbMats. The estimator (FullObsHandler)
// supplies the per-reference overlap exp(Ov_p) and uniform weight 1/P (getReferenceWeight), reproducing
// the stochastic trial bra <Psi_T| ~ (1/P) sum_p <psi_p|.
template<MEMORY_SPACE MEM, class devPsiT>
template<class RefMat>
void StochasticWfn<MEM, devPsiT>::fill_references_from_draw(int number_of_references, RefMat&& Refs)
{
  draw_bp_reference_ensemble();
  using nda::range;
  auto all = range::all;
  memory::check_memory_space<MEM>(Refs);
  const WALKER_TYPES wt       = nomsd_.getWalkerType();
  const int nel               = nup + (wt == COLLINEAR ? ndown : 0);
  const int npol              = (wt == NONCOLLINEAR ? 2 : 1);
  WalkerSet<MEM> const& inner = inner_wset();
  if (number_of_references == 0)
    return;
  if (number_of_references < 0)
    number_of_references = inner_n_samples_;
  utils::check(number_of_references > 0 and number_of_references <= inner_n_samples_ and
                   number_of_references <= int(Refs.extent(0)),
               "Invalid number_of_references: {}", number_of_references);
  utils::check(Refs.extent(1) == npol * NMO and Refs.extent(2) == nel, "Size mismatch");
  for (int p = 0; p < number_of_references; ++p)
  {
    nda::tensor::add(nda::conj(inner.SlaterMatrices(Alpha)(p, all, all)), "ij", Refs(p, all, range(nup)), "ij");
    if (wt == COLLINEAR)
      nda::tensor::add(nda::conj(inner.SlaterMatrices(Beta)(p, all, all)), "ij", Refs(p, all, range(nup, nel)),
                       "ij");
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class RefMat>
void StochasticWfn<MEM, devPsiT>::getReferences(RefMat&& Refs)
{
  if (not bp_uses_inner_ensemble())
  {
    nomsd_.getReferences(Refs);
    return;
  }
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  const int nel         = nup + (wt == COLLINEAR ? ndown : 0);
  const int npol        = (wt == NONCOLLINEAR ? 2 : 1);
  Refs.resize(inner_n_samples_, npol * NMO, nel);
  fill_references_from_draw(inner_n_samples_, Refs);
}

} // namespace afqmc
} // namespace sfqmc
