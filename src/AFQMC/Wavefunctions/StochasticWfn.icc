#include <cmath>
#include <unordered_set>

#include "IO/ptree/ptree_utilities.hpp"
#include "utilities/FairDivide.hpp"
#include "utilities/check.hpp"
#include "AFQMC/SlaterDeterminantOperations/density_matrix.hpp"

namespace sfqmc
{
namespace afqmc
{

template<MEMORY_SPACE MEM, class devPsiT>
StochasticWfn<MEM, devPsiT>::StochasticWfn(AFQMCInfo& info,
                                             ptree pt_in,
                                             std::shared_ptr<utils::mpi_context_t<mpi3::communicator>> mpi_in,
                                             HamiltonianOperations<MEM>&& outer_hop_,
                                             nda::array<ComplexType, 1>&& ci_,
                                             nda::array<devPsiT, 2>&& orbs_,
                                             std::unique_ptr<StochasticInnerStack<MEM, devPsiT>>&& inner_stack_in,
                                             WALKER_TYPES wlk,
                                             ComplexType nce,
                                             [[maybe_unused]] int targetNW)
    : AFQMCInfo(info),
      mpi_(std::move(mpi_in)),
      nomsd_(info, nomsd_inputs(pt_in), wlk, mpi_, std::move(outer_hop_), std::move(ci_), std::move(orbs_), nce,
             targetNW),
      inner_stack_(std::move(inner_stack_in))
{
  if (inner_stack_ == nullptr)
    APP_ABORT("Error in StochasticWfn: inner stack must be provided (see WavefunctionFactory).");
  ptree pt = interpret_inputs(pt_in);
  inner_nwalkers_    = pt.get<int>("inner_nwalkers");
  inner_nsteps_      = pt.get<int>("inner_nsteps");
  inner_conditioning_ = pt.get<bool>("inner_conditioning");
  inner_leapfrog_    = pt.get<bool>("inner_leapfrog");
  int inner_seed     = pt.get<int>("inner_seed");
  inner_ensemble_.rng =
      std::make_shared<utils::RandomGenerator_t<HOST_MEMORY>>(utils::split_seed(inner_seed, mpi_->comm));
  if (auto prop_pt = pt.get_child_optional("inner_propagator"))
    inner_timestep_ = prop_pt->get<double>("timestep", 0.01);
  if (inner_nsteps_ > 0)
  {
    if (wlk != CLOSED)
      APP_ABORT("Error in StochasticWfn: inner_nsteps > 0 (dynamic stochastic trial) currently supports "
                "CLOSED (RHF) trials only -- COLLINEAR/NONCOLLINEAR full-G is a follow-up.");
#if defined(ENABLE_DEVICE)
    APP_ABORT("Error in StochasticWfn: inner_nsteps > 0 (dynamic stochastic trial) is CPU-only; the "
              "un-rotated full-G kernels are not yet implemented for device builds.");
#endif
  }
  if (inner_conditioning_ && inner_nsteps_ <= 0)
    APP_ABORT("Error in StochasticWfn: inner_conditioning = true (Phase 3c-i, walker-conditioned "
              "inner sampling) requires inner_nsteps > 0; it has no effect on the static ensemble.");
  if (inner_leapfrog_ && not inner_conditioning_)
    APP_ABORT("Error in StochasticWfn: inner_leapfrog = true (Phase 3c-ii, propagate-then-resample "
              "leapfrog for exact N(phi) cancellation) requires inner_conditioning = true.");
  app_log(2, "\nStochasticWfn input:\n{}\n", io::to_string(pt));
}

template<MEMORY_SPACE MEM, class devPsiT>
ptree StochasticWfn<MEM, devPsiT>::interpret_inputs(const ptree pt0)
{
  ptree pt1 = nomsd_inputs(pt0);
  int inner_nwalkers = pt0.get<int>("inner_nwalkers", 1);
  if (inner_nwalkers < 1)
    APP_ABORT("Error in StochasticWfn::interpret_inputs: inner_nwalkers must be >= 1.");
  int inner_nsteps = pt0.get<int>("inner_nsteps", 0);
  if (inner_nsteps < 0)
    APP_ABORT("Error in StochasticWfn::interpret_inputs: inner_nsteps must be >= 0.");
  bool inner_conditioning = pt0.get<bool>("inner_conditioning", false);
  bool inner_leapfrog = pt0.get<bool>("inner_leapfrog", false);
  int inner_seed = pt0.get<int>("inner_seed", 777);
  pt1.put("inner_nwalkers", inner_nwalkers);
  pt1.put("inner_nsteps", inner_nsteps);
  pt1.put("inner_conditioning", inner_conditioning);
  pt1.put("inner_leapfrog", inner_leapfrog);
  pt1.put("inner_seed", inner_seed);
  if (auto prop_pt = pt0.get_child_optional("inner_propagator"))
    pt1.put_child("inner_propagator", *prop_pt);
  std::unordered_set<std::string> pass_through_keys = {
      "system",
      "name",
      "ndets_to_read",
      "restart_file",
      "filename",
      "stochastic",
      "inner_nwalkers",
      "inner_nsteps",
      "inner_conditioning",
      "inner_leapfrog",
      "inner_seed",
      "inner_propagator",
  };
  io::compare_known_keys("Stochastic trial wavefunction (StochasticWfn)", pt1, pt0, pass_through_keys);
  return pt1;
}

template<MEMORY_SPACE MEM, class devPsiT>
int StochasticWfn<MEM, devPsiT>::dm_size(bool full) const
{
  return nomsd_.dm_size(full);
}

template<MEMORY_SPACE MEM, class devPsiT>
bool StochasticWfn<MEM, devPsiT>::compact_G_for_vbias() const
{
  return nomsd_.ci.size() == 1;
}

template<MEMORY_SPACE MEM, class devPsiT>
WalkerSet<MEM>& StochasticWfn<MEM, devPsiT>::inner_wset()
{
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::inner_wset: inner walkers not initialized.");
  return *inner_ensemble_.wset;
}

template<MEMORY_SPACE MEM, class devPsiT>
WalkerSet<MEM> const& StochasticWfn<MEM, devPsiT>::inner_wset() const
{
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::inner_wset: inner walkers not initialized.");
  return *inner_ensemble_.wset;
}

template<MEMORY_SPACE MEM, class devPsiT>
void StochasticWfn<MEM, devPsiT>::initialize_inner_walkers(
    ptree const& walker_pt, memory::const_shared_array<HOST_MEMORY, ComplexType, 3> const& initial_guess, int NAEB)
{
  if (inner_ensemble_.initialized)
    APP_ABORT("Error in StochasticWfn::initialize_inner_walkers: inner walkers already initialized.");
  inner_ensemble_.wset = std::make_unique<WalkerSet<MEM>>(
      make_WalkerSet<MEM>(mpi_, walker_pt, static_cast<AFQMCInfo&>(*this), inner_ensemble_.rng));
  nda::array<ComplexType, 3> guess_host(initial_guess());
  inner_anchor_ = guess_host;
#if defined(ENABLE_DEVICE)
  if constexpr (MEM == DEVICE_MEMORY)
    inner_ensemble_.wset->resize(inner_nwalkers_, nda::to_device(guess_host));
  else
#endif
    inner_ensemble_.wset->resize(inner_nwalkers_, guess_host);
  (void)NAEB;
  inner_ensemble_.initialized = true;
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class TVec>
void StochasticWfn<MEM, devPsiT>::Log_Overlap(const WlkSet& wset, TVec&& Ov, int nt)
{
  (void)nt;
  memory::check_memory_space<MEM>(Ov);
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::Log_Overlap: inner walkers not initialized.");
  if (at_delegate_limit())
  {
    nomsd_.Log_Overlap(wset, std::forward<TVec>(Ov), nt);
    return;
  }
  conditioned_resample(wset);

  WalkerSet<MEM>& inner  = *inner_ensemble_.wset;
  const int nw           = wset.size();
  // Phase 3c-i: with conditioning, inner is block-structured (nw*P walkers, slot-major q = ip*nw + w);
  // pair tk maps to outer walker iw = tk % nw and inner walker q = tk (its own conditioned sample).
  // Without conditioning (Phase 3b), inner has P shared walkers paired against all outer walkers.
  const bool conditioned = (inner_conditioning_ && inner_nsteps_ > 0);
  // Phase 3c-ii leapfrog: reweight each per-sample term by 1/|<psi_q|phi_q^cond>| (computed at the
  // resample), so old_ovlp = Sum_p S_p and the step overlap RATIO new/old is exactly Eq. 25 (N(phi)
  // cancels). Without leapfrog (3c-i/3b), the absolute (1/P) Sum_p <psi_p|phi_w> reduction is kept.
  const bool leapfrog    = (conditioned && inner_leapfrog_);
  const int P            = (conditioned ? inner_nwalkers_ : int(inner.size()));
  utils::check(Ov.size() >= nw, "Size mismatch");
  utils::check(P >= 1, "inner ensemble must be non-empty");
  if (conditioned)
    utils::check(inner.size() == long(nw) * P, "conditioned inner ensemble size mismatch (expect nw*P)");
  if (leapfrog)
    utils::check(inner_cond_mag_.size() == long(nw) * P,
                 "leapfrog inner_cond_mag_ not sized -- conditioned resample must run first");
  const ComplexType inv_P(1.0 / static_cast<double>(P), 0.0);
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  auto all              = nda::range::all;

  Ov() = ComplexType(0.0);

  int tk0, tkN;
  std::tie(tk0, tkN) = FairDivideBoundary(mpi_->comm.rank(), nw * P, mpi_->comm.size());

  memory::buffered_array<MEM, ComplexType, 1> log_ov(1, ComplexType(0.0));
  memory::buffered_array<MEM, ComplexType, 3> inner_one(1, NMO, nup);
  memory::buffered_array<MEM, ComplexType, 3> outer_one(1, NMO, nup);

  for (int tk = tk0; tk < tkN; ++tk)
  {
    const int iw = (conditioned ? tk % nw : tk / P);
    const int ip = (conditioned ? tk : tk % P);
    inner_one(0, all, all) = inner.SlaterMatrices(Alpha)(ip, all, all);
    outer_one(0, all, all) = wset.SlaterMatrices(Alpha)(iw, all, all);
    log_ov(0)              = ComplexType(0.0);
    det_ops::Log_Overlap(inner_one, outer_one, log_ov);
    if (wt == CLOSED)
      nda::tensor::scale(ComplexType(2.0), log_ov);
    ComplexType ov = std::exp(log_ov(0));
    if (wt == COLLINEAR)
    {
      memory::buffered_array<MEM, ComplexType, 3> inner_beta(1, NMO, ndown);
      memory::buffered_array<MEM, ComplexType, 3> outer_beta(1, NMO, ndown);
      inner_beta(0, all, all) = inner.SlaterMatrices(Beta)(ip, all, all);
      outer_beta(0, all, all) = wset.SlaterMatrices(Beta)(iw, all, all);
      log_ov(0)               = ComplexType(0.0);
      det_ops::Log_Overlap(inner_beta, outer_beta, log_ov);
      ov *= std::exp(log_ov(0));
    }
    if (leapfrog)
    {
      // q == tk in conditioned (slot-major) layout; reweight by the conditioning-walker magnitude.
      double mag = double(inner_cond_mag_(tk));
      if (mag > 0.0)
        Ov(iw) += ov / ComplexType(mag, 0.0);
    }
    else
      Ov(iw) += inv_P * ov;
  }

  if (mpi_->comm.size() > 1)
    mpi_->comm.all_reduce_in_place_n(Ov().data(), nw, std::plus<>{});

  // The pair loop accumulates the LINEAR effective overlap: (1/P) sum_p <psi_p|phi_w> normally, or the
  // leapfrog-reweighted sum_p <psi_p|phi_w>/|<psi_p|phi_cond>| (so new/old reproduces Eq. 25). The OVLP
  // property convention (matching NOMSD::Log_Overlap) is the LOG overlap, so convert back here.
  for (int iw = 0; iw < nw; ++iw)
    Ov(iw) = std::log(Ov(iw));
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::Log_Overlap(WlkSet& wset)
{
  if (at_delegate_limit())
  {
    nomsd_.Log_Overlap(wset);
    return;
  }
  int nw = wset.size();
  memory::buffered_array<MEM, ComplexType, 1> ovlp(nw, ComplexType(0.0));
  Log_Overlap(wset, ovlp);
  wset.setProperty(OVLP, ovlp);
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class Mat, class TVec>
void StochasticWfn<MEM, devPsiT>::Energy(const WlkSet& wset, Mat&& E, TVec&& Ov, int nt)
{
  (void)nt;
  memory::check_memory_space<MEM>(E, Ov);
  utils::check(E.shape() == std::array<long, 2>{wset.size(), 3}, "Size mismatch");
  utils::check(Ov.size() == wset.size(), "Size mismatch");
  if (at_delegate_limit())
  {
    nomsd_.Energy(wset, std::forward<Mat>(E), std::forward<TVec>(Ov), nt);
    return;
  }

  const int nwalk         = wset.size();
  const ComplexType zero(0.0);
  const bool full         = (inner_nsteps_ > 0);
  const bool compact      = not full;
  const int Gsize         = dm_size(full);

  memory::buffered_array<MEM, ComplexType, 2> eloc2(nwalk, 3);
  memory::buffered_array<MEM, ComplexType, 1> D(nwalk, zero);
  E()  = zero;
  Ov() = zero;

  reduce_inner_cross_dm(
      wset, compact, Gsize, D, Ov,
      [&](auto& Gp, auto& /*ov_*/, auto& Sp, int /*ip*/, int /*r0*/, int /*rN*/) {
        eloc2() = zero;
        if (full)
          nomsd_.energy_from_fullG(eloc2, Gp);
        else
          nomsd_.energy_from_G(eloc2, Gp, 0);
        for (int w = 0; w < nwalk; ++w)
          E(w, nda::range::all) += Sp(w) * eloc2(w, nda::range::all);
      });

  if (mpi_->comm.size() > 1)
    mpi_->comm.all_reduce_in_place_n(E().data(), 3 * nwalk, std::plus<>{});
  for (int w = 0; w < nwalk; ++w)
    E(w, nda::range::all) /= D(w);

  // reduce_inner_cross_dm fills Ov with the LINEAR effective overlap (1/P) sum_p <psi_p|phi_w>; the
  // OVLP property convention (matching NOMSD::Energy) is the LOG overlap, so convert back here.
  for (int w = 0; w < nwalk; ++w)
    Ov(w) = std::log(Ov(w));
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::Energy(WlkSet& wset)
{
  if (at_delegate_limit())
  {
    nomsd_.Energy(wset);
    return;
  }
  int nw = wset.size();
  memory::buffered_array<MEM, ComplexType, 1> ovlp(nw, ComplexType(0.0));
  memory::buffered_array<MEM, ComplexType, 2> eloc(nw, 3);
  Energy(wset, eloc, ovlp);
  wset.setProperty(OVLP, ovlp);
  wset.setProperty(E1_, eloc(nda::range::all, 0));
  wset.setProperty(EXX_, eloc(nda::range::all, 1));
  wset.setProperty(EJ_, eloc(nda::range::all, 2));
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, nda::MemoryMatrix MatA>
void StochasticWfn<MEM, devPsiT>::vbias(WlkSet& wset, MatA&& v, double dt, int nt)
{
  if (at_delegate_limit())
  {
    nomsd_.vbias(wset, std::forward<MatA>(v), dt, nt);
    return;
  }
  const int nwalk = wset.size();
  const bool full = (inner_nsteps_ > 0);
  const int Gsize = dm_size(full);
  memory::buffered_array<MEM, ComplexType, 2> G(nwalk, Gsize);
  MixedDensityMatrix_for_vbias(wset, G);
  v() = ComplexType(0.0);
  // vbias_from_G -> HamOp.vbias dispatches on the G layout: a compact G when the inner ensemble is
  // at the anchor (inner_nsteps == 0) and a full NMO*NMO G once it has moved off (inner_nsteps > 0),
  // so a single seam covers both. (full is still used above to size G via dm_size.)
  nomsd_.vbias_from_G(G, std::forward<MatA>(v), dt);
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::begin_inner_step(WlkSet& wset)
{
  inner_step_pending_ = true;
  // Phase 3c-ii leapfrog: resample conditioned on the current (old) walker phi and refresh the stored
  // OVLP = <Psi_T|phi> against that just-sampled ensemble. Log_Overlap(wset) consumes the latch just
  // armed (driving the conditioned resample + inner_cond_mag_), then stores the importance-reweighted
  // old overlap. The post-propagation Log_Overlap reuses the SAME ensemble, so the step's overlap RATIO
  // new/old is exactly Eq. 25 and N(phi) cancels.
  if (inner_leapfrog_ && inner_conditioning_ && inner_nsteps_ > 0)
    Log_Overlap(wset);
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::conditioned_resample(const WlkSet& wset)
{
  if (inner_conditioning_ && inner_nsteps_ > 0)
  {
    const int nw = int(wset.size());
    // Resample when the per-step latch is armed (the first reduction of an outer step owns the
    // resample; later reductions in the same step reuse the ensemble), OR when the ensemble is not yet
    // sized/conditioned for the current outer-walker count (bootstrap: priming overlap/energy calls
    // before the propagator arms the latch, and any change in the outer walker count). Otherwise the
    // ensemble is already conditioned for this configuration -- reuse it.
    const bool need_resample =
        inner_step_pending_ || (inner_ensemble_.wset->size() != long(nw) * inner_nwalkers_);
    if (not need_resample)
      return;
    // Phase 3c-i: importance-sample the inner fields conditioned on each outer walker phi_w (Eq. 23 of
    // arXiv:2505.18519). The inner trial IS the anchor phi_T, so the inner NOMSD's own mixed DM + vbias
    // on the OUTER walker set yields the conditioning force bias
    //   x_bar(phi_w) = sqrt(dt) * L^var . <phi_T|c+c|phi_w> / <phi_T|phi_w>
    // (the sqrt(dt)*[2 for CLOSED] prefactor and the overlap normalization come from HamOp.vbias /
    // MixedDensityMatrix, matching the field-shift convention assemble_X expects). No bespoke contraction.
    const int nc  = inner_nomsd().dm_size(false); // compact cross-DM size (inner trial is single-det)
    const int nCV = inner_nomsd().number_of_cholesky_vectors();
    memory::buffered_array<MEM, ComplexType, 2> Gcross(nw, nc);
    memory::buffered_array<MEM, ComplexType, 1> ovcross(nw);
    Gcross()  = ComplexType(0.0);
    ovcross() = ComplexType(0.0);
    inner_nomsd().MixedDensityMatrix(wset, Gcross, ovcross, true);
    memory::array<MEM, ComplexType, 2> X_bias(nw, nCV);
    X_bias() = ComplexType(0.0);
    inner_nomsd().vbias_from_G(Gcross, X_bias, inner_timestep_);
    advance_inner_ensemble_conditioned(X_bias, nw);
    if (inner_leapfrog_)
      compute_inner_cond_mag(wset); // |<psi_q|phi_w^cond>| for the leapfrog overlap reweighting (Eq. 25)
  }
  else
  {
    // Phase 3b: walker-independent free-projection resample (honors the latch + static no-op).
    maybe_advance_inner_ensemble();
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet>
void StochasticWfn<MEM, devPsiT>::compute_inner_cond_mag(const WlkSet& wset)
{
  // |<psi_q | phi_w^cond>| for each inner walker q = ip*nw + w (slot-major), where phi_w^cond is the
  // outer walker its block was conditioned on in the resample just completed. The leapfrog overlap
  // (Log_Overlap below) divides each per-sample term by this, so old_ovlp = Sum_p S_p and the step
  // ratio new/old is exactly Eq. 25 of arXiv:2505.18519 (N(phi) cancels). Same det(A^dag B) /
  // CLOSED-doubling convention as the Log_Overlap reduction. Replicated across ranks (cheap; the
  // FairDivided Log_Overlap reads it per pair). CLOSED-only in practice (leapfrog gate), beta included
  // for completeness.
  WalkerSet<MEM>& inner = *inner_ensemble_.wset;
  const int nw          = int(wset.size());
  const int P           = inner_nwalkers_;
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  auto all              = nda::range::all;
  inner_cond_mag_       = nda::array<RealType, 1>(long(nw) * P);
  memory::buffered_array<MEM, ComplexType, 1> logov(nw);
  memory::buffered_array<MEM, ComplexType, 1> logov_b(nw);
  for (int ip = 0; ip < P; ++ip)
  {
    auto inner_a = inner.SlaterMatrices(Alpha)(nda::range(long(ip) * nw, long(ip + 1) * nw), all, all);
    logov() = ComplexType(0.0);
    det_ops::Log_Overlap(inner_a, wset.SlaterMatrices(Alpha), logov);
    if (wt == CLOSED)
      nda::tensor::scale(ComplexType(2.0), logov);
    else if (wt == COLLINEAR)
    {
      auto inner_b = inner.SlaterMatrices(Beta)(nda::range(long(ip) * nw, long(ip + 1) * nw), all, all);
      logov_b()    = ComplexType(0.0);
      det_ops::Log_Overlap(inner_b, wset.SlaterMatrices(Beta), logov_b);
    }
    for (int w = 0; w < nw; ++w)
    {
      ComplexType lo = logov(w);
      if (wt == COLLINEAR)
        lo += logov_b(w);
      inner_cond_mag_(long(ip) * nw + w) = std::abs(std::exp(lo));
    }
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class TVecD, class TVecOv, class Accumulate>
void StochasticWfn<MEM, devPsiT>::reduce_inner_cross_dm(const WlkSet& wset,
                                                         bool compact,
                                                         int Gsize,
                                                         TVecD&& D,
                                                         TVecOv&& Ov,
                                                         Accumulate&& accumulate)
{
  memory::check_memory_space<MEM>(D, Ov);
  if (at_delegate_limit())
    APP_ABORT("Error in StochasticWfn::reduce_inner_cross_dm: called at delegate limit "
              "(inner_nwalkers=1, inner_nsteps=0); use nomsd_ reductions instead.");
  if (not inner_ensemble_.initialized || inner_ensemble_.wset == nullptr)
    APP_ABORT("Error in StochasticWfn::reduce_inner_cross_dm: inner walkers not initialized.");
  conditioned_resample(wset);

  WalkerSet<MEM>& inner  = *inner_ensemble_.wset;
  const int nwalk        = wset.size();
  // Phase 3c-i: when conditioning, the inner ensemble is block-structured (nwalk*P walkers, slot-major
  // index q = ip*nwalk + w, block w conditioned on outer walker phi_w). The loop runs over the P
  // per-walker samples; slot ip pairs its nwalk inner walkers diagonally with the nwalk outer walkers
  // via the batched-reference MixedDensityMatrix. Without conditioning (Phase 3b) the ensemble is P
  // shared walkers, each paired against all outer walkers with a single reference.
  const bool conditioned = (inner_conditioning_ && inner_nsteps_ > 0);
  const int P            = (conditioned ? inner_nwalkers_ : int(inner.size()));
  utils::check(P >= 1, "inner ensemble must be non-empty");
  if (conditioned)
    utils::check(inner.size() == long(nwalk) * P, "conditioned inner ensemble size mismatch (expect nwalk*P)");
  const WALKER_TYPES wt = nomsd_.getWalkerType();
  const ComplexType zero(0.0);
  const ComplexType inv_P(1.0 / static_cast<double>(P), 0.0);
  const int nel         = (wt == COLLINEAR ? nup + ndown : nup);
  const int nspin       = (wt == COLLINEAR ? 2 : 1);
  const int npol        = (wt == NONCOLLINEAR ? 2 : 1);
  auto all              = nda::range::all;

  utils::check(Gsize == dm_size(not compact), "Gsize mismatch");
  utils::check(D.size() == nwalk && Ov.size() == nwalk, "Size mismatch");

  memory::buffered_array<MEM, ComplexType, 2> Gp(nwalk, Gsize);
  memory::buffered_array<MEM, ComplexType, 1> ov_(nwalk, zero);
  memory::buffered_array<MEM, ComplexType, 1> Sp(nwalk, zero);

  D()  = zero;
  Ov() = zero;

  memory::array<MEM, ComplexType, 2> ref_alpha(NMO, nup);
  memory::array<MEM, ComplexType, 2> ref_beta(NMO, ndown);

  for (int ip = 0; ip < P; ++ip)
  {
    Gp()  = zero;
    ov_() = zero;
    if (conditioned)
    {
      // slot ip: inner walkers [ip*nwalk, (ip+1)*nwalk) paired element-wise with the outer walkers.
      auto inner_a = inner.SlaterMatrices(Alpha)(nda::range(long(ip) * nwalk, long(ip + 1) * nwalk), all, all);
      if (compact)
      {
        auto G3d = nda::reshape(Gp, std::array<long, 3>{nwalk, nel, npol * NMO});
        det_ops::MixedDensityMatrix(inner_a, wset.SlaterMatrices(Alpha), G3d(all, nda::range(nup), all), ov_,
                                    compact);
        if (wt == CLOSED)
          nda::tensor::scale(ComplexType(2.0), ov_);
        else if (wt == COLLINEAR)
        {
          auto inner_b = inner.SlaterMatrices(Beta)(nda::range(long(ip) * nwalk, long(ip + 1) * nwalk), all, all);
          det_ops::MixedDensityMatrix(inner_b, wset.SlaterMatrices(Beta), G3d(all, nda::range(nup, nel), all), ov_,
                                      compact);
        }
      }
      else
      {
        auto G3d = nda::reshape(Gp, std::array<long, 3>{nwalk, nspin * npol * NMO, npol * NMO});
        det_ops::MixedDensityMatrix(inner_a, wset.SlaterMatrices(Alpha), G3d(all, nda::range(npol * NMO), all),
                                    ov_, compact);
        if (wt == CLOSED)
          nda::tensor::scale(ComplexType(2.0), ov_);
        else if (wt == COLLINEAR)
        {
          auto inner_b = inner.SlaterMatrices(Beta)(nda::range(long(ip) * nwalk, long(ip + 1) * nwalk), all, all);
          det_ops::MixedDensityMatrix(inner_b, wset.SlaterMatrices(Beta),
                                      G3d(all, nda::range(npol * NMO, nspin * npol * NMO), all), ov_, compact);
        }
      }
    }
    else if (compact)
    {
      ref_alpha() = inner.SlaterMatrices(Alpha)(ip, all, all);
      auto G3d = nda::reshape(Gp, std::array<long, 3>{nwalk, nel, npol * NMO});
      det_ops::MixedDensityMatrix(ref_alpha, wset.SlaterMatrices(Alpha), G3d(all, nda::range(nup), all), ov_,
                                  compact, false);
      if (wt == CLOSED)
        nda::tensor::scale(ComplexType(2.0), ov_);
      else if (wt == COLLINEAR)
      {
        ref_beta() = inner.SlaterMatrices(Beta)(ip, all, all);
        det_ops::MixedDensityMatrix(ref_beta, wset.SlaterMatrices(Beta), G3d(all, nda::range(nup, nel), all), ov_,
                                    compact, false);
      }
    }
    else
    {
      ref_alpha() = inner.SlaterMatrices(Alpha)(ip, all, all);
      auto G3d = nda::reshape(Gp, std::array<long, 3>{nwalk, nspin * npol * NMO, npol * NMO});
      det_ops::MixedDensityMatrix(ref_alpha, wset.SlaterMatrices(Alpha), G3d(all, nda::range(npol * NMO), all),
                                  ov_, compact, false);
      if (wt == CLOSED)
        nda::tensor::scale(ComplexType(2.0), ov_);
      else if (wt == COLLINEAR)
      {
        ref_beta() = inner.SlaterMatrices(Beta)(ip, all, all);
        det_ops::MixedDensityMatrix(ref_beta, wset.SlaterMatrices(Beta),
                                    G3d(all, nda::range(npol * NMO, nspin * npol * NMO), all), ov_, compact,
                                    false);
      }
    }

    for (int w = 0; w < nwalk; ++w)
    {
      ComplexType lin_ov = std::exp(ov_(w));
      double mag         = std::abs(lin_ov);
      ComplexType s      = (mag > 0.0) ? (lin_ov / ComplexType(mag, 0.0)) : zero;
      Sp(w)              = s;
      D(w)               = D(w) + s;
      Ov(w)              = Ov(w) + inv_P * lin_ov;
    }
    accumulate(Gp, ov_, Sp, ip, 0, Gsize);
    mpi_->comm.barrier();
  }
}

template<MEMORY_SPACE MEM, class devPsiT>
template<class WlkSet, class MatG>
void StochasticWfn<MEM, devPsiT>::MixedDensityMatrix_for_vbias(const WlkSet& wset, MatG&& G)
{
  if (at_delegate_limit())
  {
    nomsd_.MixedDensityMatrix(wset, std::forward<MatG>(G), compact_G_for_vbias());
    return;
  }
  memory::check_memory_space<MEM>(G);
  const int nwalk       = wset.size();
  const ComplexType zero(0.0);
  const bool full       = (inner_nsteps_ > 0);
  const bool compact    = full ? false : compact_G_for_vbias();
  const int Gsize       = full ? dm_size(true) : dm_size(not compact);

  utils::check(G.shape() == std::array<long, 2>{nwalk, Gsize}, "Size mismatch");

  memory::buffered_array<MEM, ComplexType, 2> Gnum(nwalk, Gsize);
  Gnum() = zero;
  memory::buffered_array<MEM, ComplexType, 1> D(nwalk, zero);
  memory::buffered_array<MEM, ComplexType, 1> Ov(nwalk, zero);

  reduce_inner_cross_dm(
      wset, compact, Gsize, D, Ov,
      [&](auto& Gp, auto& /*ov_*/, auto& Sp, int /*ip*/, int /*r0*/, int /*rN*/) {
        for (int w = 0; w < nwalk; ++w)
          Gnum(w, nda::range::all) += Sp(w) * Gp(w, nda::range::all);
      });

  for (int w = 0; w < nwalk; ++w)
    Gnum(w, nda::range::all) /= D(w);
  G() = Gnum();
}

} // namespace afqmc
} // namespace sfqmc
