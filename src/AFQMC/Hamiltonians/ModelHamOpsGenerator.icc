#include<unordered_map>

namespace sfqmc
{
namespace afqmc
{

template<MEMORY_SPACE MEM, bool REAL, typename ValueType>
SparseEnergy<MEM,REAL> ModelHamOpsGenerator::make_SparseEnergy(
      std::shared_ptr<utils::mpi_context_t<mpi3::communicator>> mpi, 
      WALKER_TYPES type, math::sparse::csr_matrix<ValueType, HOST_MEMORY, int, int>& hij, 
      math::sparse::csr_matrix<ValueType, HOST_MEMORY, int, int>& U, 
      math::sparse::csr_matrix<ValueType, HOST_MEMORY, int, int>& J, ComplexType E0)
{
  using nda::range;
  using csrM = math::sparse::csr_matrix<ValueType, HOST_MEMORY, int, int>;
  auto all = range::all;
  int npol = (type == NONCOLLINEAR or type == NONCOLLINEAR_FT ? 2 : 1 );
  int NMO = hij.extent(0)/2;
  long M = NMO;
  long M2 = npol*M; 
  long Madd = M2-M; 

  utils::check_shape(hij, "hij", 2*NMO, M2);

  nda::array<long,1> n2IJ;

  // to avoid extra logic, see below
  int SX = (type == NONCOLLINEAR or type == NONCOLLINEAR_FT ? 0 : 1 );

  /**********************************************************/
  // create mapping  
  /**********************************************************/

  {
    std::vector<long> IJ;
    IJ.reserve(20*NMO);
    // to avoid adding too many copies
    std::vector<bool> Idone(2*NMO, false);

    // add 1-body terms to the mapping
    {
      long norb = hij.extent(0);
      auto cols = hij.columns();
      for(long i=0; i<norb; ++i) {
        for(long p=hij.row_begin(i); p<hij.row_end(i); ++p) {
          long j = long(cols(p));
	  // maps "beta" component to [0,M*M)
          IJ.push_back( (i%M2) * M2 + j );
        } 
      }
    }

    // General mapping for both COLLINEAR and NONCOLLINEAR
    // IJ = i*M2+j               for up/up
    //    = (i+Madd)*M2+j+Madd   for dn/dn
    // Or in other words, i and j become i+Madd and j+Madd for dn spin   
    // U opposite spin
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i); p<U.row_end(i); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i > j ) continue;
        if( i == j ) {  
          if(not Idone[i]) {
            Idone[i] = true;
            IJ.push_back(i*M2+i);              // ( i up, i up)
            IJ.push_back((i+Madd)*M2+i+Madd);  // ( i dn, i dn)
          }
          if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
            IJ.push_back(i*M2+i+M);         // ( i up, i dn)
            IJ.push_back((i+M)*M2+i);       // ( i dn, i up)
          }
        } else {
          if(not Idone[i]) {
            Idone[i] = true;
            IJ.push_back(i*M2+i);              // ( i up, i up)
            IJ.push_back((i+Madd)*M2+i+Madd);  // ( i dn, i dn)
          }
          if(not Idone[j]) {
            Idone[j] = true;
            IJ.push_back(j*M2+j);           // ( j up, j up)
            IJ.push_back((j+Madd)*M2+j+Madd);  // ( j dn, j dn)
          }
          if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
            IJ.push_back(i*M2+j+M);         // ( i up, j dn)
            IJ.push_back((j+M)*M2+i);       // ( j dn, i up)
            IJ.push_back((i+M)*M2+j);       // ( i dn, j up)
            IJ.push_back(j*M2+i+M);         // ( j up, i dn)
          }
        }  
      }
    }
    // U same spin
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i+M); p<U.row_end(i+M); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i >= j ) continue;
        if(not Idone[i]) {
          Idone[i] = true;
          IJ.push_back(i*M2+i);                // ( i up, i up)
          IJ.push_back((i+Madd)*M2+i+Madd);    // ( i dn, i dn)
        }
        if(not Idone[j]) {
          Idone[j] = true;
          IJ.push_back(j*M2+j);              // ( j up, j up)
          IJ.push_back((j+Madd)*M2+j+Madd);  // ( j dn, j dn)
        }
        IJ.push_back(i*M2+j);                // ( i up, j up)
        IJ.push_back(j*M2+i);                // ( j up, i up)
        IJ.push_back((i+Madd)*M2+j+Madd);    // ( i dn, j dn)
        IJ.push_back((j+Madd)*M2+i+Madd);    // ( j dn, i dn)
      }
    }
    for(long i=0; i<M; ++i) {
      for(long p=J.row_begin(i); p<J.row_end(i); ++p) {
        auto Jij = J.values(i);
        long j = long(J.columns(i));
        if( std::abs(Jij) < 1e-6 ) continue;
        if( i >= j ) continue;
        IJ.push_back(i*M2+j);               // ( i up, j up)
        IJ.push_back(j*M2+i);               // ( j up, i up)
        IJ.push_back((j+Madd)*M2+i+Madd);   // ( j dn, i dn)
        IJ.push_back((i+Madd)*M2+j+Madd);   // ( i dn, j dn)
        if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
          IJ.push_back(i*M2+i+M);           // ( i up, i dn)
          IJ.push_back((j+M)*M2+j);         // ( j dn, j up)
          IJ.push_back(i*M2+j+M);           // ( i up, j dn)
          IJ.push_back((i+M)*M2+j);         // ( i dn, j up)
          IJ.push_back(j*M2+j+M);           // ( j up, j dn)
          IJ.push_back((i+M)*M2+i);         // ( i dn, i up)
          IJ.push_back(j*M2+i+M);           // ( j up, i dn)
          IJ.push_back((j+M)*M2+i);         // ( j dn, i up)
        }  
      }
    }

    std::sort(IJ.begin(), IJ.end());
    auto iend = std::unique(IJ.begin(), IJ.end());
    int nunique = std::distance( IJ.begin(), iend );

    n2IJ = nda::array<long,1>(nunique);
    std::copy_n(IJ.begin(), nunique, n2IJ.data());

  }

  /**********************************************************/
  // count energy elements per row
  /**********************************************************/
  // COLLINEAR
  // nnz_VJ[S][n], S: 0-up/up, 1-dn/dn, 2-dn/up
  // nnz_VX[S][n], S: 0-up/up, 2-dn/dn 
  // NONCOLLINEAR
  // nnz_VJ[S][n], S: 0-everything
  // nnz_VX[S][n], S: 0-everything
  // 
  // VJ[2] = VJ(beta, alpha) + Transpose( VJ(alpha,beta) )
  // See HamiltonianOperations/ModelComponents/SparseEnergy.hpp to see how it is used.
  nda::array<int,2> nnz_VJ(3,n2IJ.extent(0)), nnz_VX(2,n2IJ.extent(0));
  nnz_VJ() = 0;
  nnz_VX() = 0;
  using map_t = std::unordered_map<long, int>;
  map_t IJ2n;

  {

    for(int n=0; n<n2IJ.extent(0); n++)
      IJ2n.insert(std::make_pair(n2IJ(n), n));

    // see the assembly of VJ/VX to understand this better
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i); p<U.row_end(i); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i > j ) continue;
        if( i == j ) {
          if(type == COLLINEAR or type == COLLINEAR_FT) {
 	    // T( VJ(alpha,beta)[iuiu][idid] ) += Uij;
  	    long idid((i+Madd)*M2+i+Madd);  // ( i dn, i dn)
            nnz_VJ(2, IJ2n[idid]) ++;  
          } else if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
            long iuiu(i*M2+i);           // ( i up, i up)
            long iuid(i*M2+i+M);         // ( i up, i dn)
            nnz_VJ(0, IJ2n[iuiu]) ++;  
            nnz_VX(0, IJ2n[iuid]) ++;  
          }
        } else {
          if(type == COLLINEAR or type == COLLINEAR_FT) {
	    // T( VJ(alpha,beta)[iuiu][jdjd] )
            long jdjd((j+Madd)*M2+j+Madd);  // ( j dn, j dn)
            nnz_VJ(2, IJ2n[jdjd]) ++;  
	    // VJ(beta,alpha)[idid][juju]
            long idid((i+Madd)*M2+i+Madd);  // ( i dn, i dn)
            nnz_VJ(2, IJ2n[idid]) ++;  
          } else if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
            long iuiu(i*M2+i);              // ( i up, i up)
            long idid((i+Madd)*M2+i+Madd);  // ( i dn, i dn)
            nnz_VJ(0, IJ2n[iuiu]) ++;  
            nnz_VJ(0, IJ2n[idid]) ++;  
            long iujd(i*M2+j+M);         // ( i up, j dn)
            long idju((i+M)*M2+j);       // ( i dn, j up)
            nnz_VX(0, IJ2n[iujd]) ++;  
            nnz_VX(0, IJ2n[idju]) ++;  
          }
        }
      }
    }
    // U same spin
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i+M); p<U.row_end(i+M); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i >= j ) continue;
        long iuiu(i*M2+i);                // ( i up, i up)
        long idid((i+Madd)*M2+i+Madd);    // ( i dn, i dn)
        nnz_VJ(SX*0, IJ2n[iuiu]) ++;  
        nnz_VJ(SX*1, IJ2n[idid]) ++;  
        long iuju(i*M2+j);                // ( i up, j up)
        long idjd((i+Madd)*M2+j+Madd);    // ( i dn, j dn)
        nnz_VX(SX*0, IJ2n[iuju]) ++;  
        nnz_VX(SX*1, IJ2n[idjd]) ++;  
      }
    }
    for(long i=0; i<M; ++i) {
      for(long p=J.row_begin(i); p<J.row_end(i); ++p) {
        auto Jij = J.values(p);
        long j = long(J.columns(p));
        if( std::abs(Jij) < 1e-6 ) continue;
        if( i >= j ) continue;
        if(type == COLLINEAR or type == COLLINEAR_FT) {
	  // T( VJ(alpha,beta)[iuju][jdid] )
	  // T( VJ(alpha,beta)[iuju][idjd] )    
          long idjd( (i+Madd)*M2+j+Madd );   // ( i dn, j dn)
          long jdid( (j+Madd)*M2+i+Madd );   // ( j dn, i dn)
          nnz_VJ(2, IJ2n[idjd]) += 2;    
          nnz_VJ(2, IJ2n[jdid]) += 2;    
        } else if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
          long iuju(i*M2+j);            // ( i up, j up)
          long juiu(j*M2+i);            // ( j up, i up)
          nnz_VJ(0, IJ2n[iuju]) += 2;    
          nnz_VJ(0, IJ2n[juiu]) += 2;    
          long iuid(i*M2+i+M);        // ( i up, i dn)
          long iujd(i*M2+j+M);        // ( i up, j dn)
          long jujd(j*M2+j+M);        // ( j up, j dn)
          long juid(j*M2+i+M);        // ( j up, i dn)
          nnz_VX(0, IJ2n[iuid]) ++;    
          nnz_VX(0, IJ2n[iujd]) ++; 
          nnz_VX(0, IJ2n[jujd]) ++; 
          nnz_VX(0, IJ2n[juid]) ++; 
        }
      }
    }
  }

  int nIJ = n2IJ.extent(0);
  std::vector<csrM> VJ, VX;

  if(type == COLLINEAR or type == COLLINEAR_FT) {
    VJ.reserve(nnz_VJ.size());
    VX.reserve(nnz_VX.size());
    for(int n=0; n<nnz_VJ.extent(0); n++)
      VJ.emplace_back(csrM({nIJ,nIJ}, nnz_VJ(n,all))); 
    for(int n=0; n<nnz_VX.extent(0); n++)
      VX.emplace_back(csrM({nIJ,nIJ}, nnz_VX(n,all))); 
  } else if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
    VJ.reserve(1);
    VX.reserve(1);
    VJ.emplace_back(csrM({nIJ,nIJ}, nnz_VJ(0,all))); 
    VX.emplace_back(csrM({nIJ,nIJ}, nnz_VX(0,all))); 
  }

  /**********************************************************/
  // assemble VJ/VX 
  /**********************************************************/
  {
    ValueType minus(-1.0);
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i); p<U.row_end(i); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i > j ) continue;
        if( i == j ) {
          auto iuiu= IJ2n[i*M2+i];              // ( i up, i up)
          auto idid= IJ2n[(i+Madd)*M2+i+Madd];  // ( i dn, i dn)
          if(type == COLLINEAR or type == COLLINEAR_FT) {
            VJ[2][idid][iuiu] += Uij;  
          } else if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
            VJ[0][iuiu][idid] += Uij;  
            auto iuid= IJ2n[i*M2+i+M];         // ( i up, i dn)
            auto idiu= IJ2n[(i+M)*M2+i];       // ( i dn, i up)
            VX[0][iuid][idiu] += (minus*Uij);  
          }
        } else {
          auto iuiu= IJ2n[i*M2+i];              // ( i up, i up)
          auto idid= IJ2n[(i+Madd)*M2+i+Madd];  // ( i dn, i dn)
          auto juju= IJ2n[j*M2+j];              // ( j up, j up)
          auto jdjd= IJ2n[(j+Madd)*M2+j+Madd];  // ( j dn, j dn)
          if(type == COLLINEAR or type == COLLINEAR_FT) {
            VJ[2][jdjd][iuiu] += Uij;  
            VJ[2][idid][juju] += Uij;  
          } else if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
            auto iujd= IJ2n[i*M2+j+M];         // ( i up, j dn)
            auto jdiu= IJ2n[(j+M)*M2+i];       // ( j dn, i up)
            auto idju= IJ2n[(i+M)*M2+j];       // ( i dn, j up)
            auto juid= IJ2n[j*M2+i+M];         // ( j up, i dn)
            VJ[0][iuiu][jdjd] += Uij;  
            VJ[0][idid][juju] += Uij;  
            VX[0][iujd][jdiu] += (minus*Uij);  
            VX[0][idju][juid] += (minus*Uij);  
          }
        }
      }
    }
    // U same spin
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i+M); p<U.row_end(i+M); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i >= j ) continue;
        auto iuiu= IJ2n[i*M2+i];                // ( i up, i up)
        auto idid= IJ2n[(i+Madd)*M2+i+Madd];    // ( i dn, i dn)
        auto juju= IJ2n[j*M2+j];                // ( j up, j up)
        auto jdjd= IJ2n[(j+Madd)*M2+j+Madd];    // ( j dn, j dn)
        VJ[SX*0][iuiu][juju] += Uij;  
        VJ[SX*1][idid][jdjd] += Uij;  
    
        auto iuju= IJ2n[i*M2+j];                // ( i up, j up)
        auto juiu= IJ2n[j*M2+i];                // ( j up, i up)
        auto idjd= IJ2n[(i+Madd)*M2+j+Madd];    // ( i dn, j dn)
        auto jdid= IJ2n[(j+Madd)*M2+i+Madd];    // ( j dn, i dn)
        VX[SX*0][iuju][juiu] += (minus*Uij);  
        VX[SX*1][idjd][jdid] += (minus*Uij);  
      }
    }
    for(long i=0; i<M; ++i) {
      for(long p=J.row_begin(i); p<J.row_end(i); ++p) {
        auto Jij = J.values(p);
        long j = long(U.columns(p));
        if( std::abs(Jij) < 1e-6 ) continue;
        if( i >= j ) continue;
        auto iuju= IJ2n[i*M2+j];               // ( i up, j up)
        auto juiu= IJ2n[j*M2+i];               // ( j up, i up)
        auto jdid= IJ2n[(j+Madd)*M2+i+Madd];   // ( j dn, i dn)
        auto idjd= IJ2n[(i+Madd)*M2+j+Madd];   // ( i dn, j dn)
        if(type == COLLINEAR or type == COLLINEAR_FT) {
          VJ[SX*2][jdid][iuju] += Jij;  
          VJ[SX*2][idjd][iuju] += Jij;  
          VJ[SX*2][idjd][juiu] += Jij;  
          VJ[SX*2][jdid][juiu] += Jij;  
        } else if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
          auto iuid= IJ2n[i*M2+i+M];        // ( i up, i dn)
          auto jdju= IJ2n[(j+M)*M2+j];      // ( j dn, j up)
          auto iujd= IJ2n[i*M2+j+M];        // ( i up, j dn)
          auto idju= IJ2n[(i+M)*M2+j];      // ( i dn, j up)
          auto jujd= IJ2n[j*M2+j+M];        // ( j up, j dn)
          auto idiu= IJ2n[(i+M)*M2+i];      // ( i dn, i up)
          auto juid= IJ2n[j*M2+i+M];        // ( j up, i dn)
          auto jdiu= IJ2n[(j+M)*M2+i];      // ( j dn, i up)
          VJ[0][iuju][jdid] += Jij;  
          VJ[0][iuju][idjd] += Jij;  
          VJ[0][juiu][idjd] += Jij;  
          VJ[0][juiu][jdid] += Jij;  
          VX[0][iuid][jdju] += (minus*Jij);  
          VX[0][iujd][idju] += (minus*Jij);  
          VX[0][jujd][idiu] += (minus*Jij);  
          VX[0][juid][jdiu] += (minus*Jij);  
        }
      }
    }
    for( auto& v : VJ ) v.remove_empty_spaces();
    for( auto& v : VX ) v.remove_empty_spaces();
  }

  std::vector<csrM> linear_hij;
  if(type == COLLINEAR or type == COLLINEAR_FT) {
    utils::check(hij.extent(0) == 2*NMO, "");
    linear_hij.reserve(2);
    auto hup = hij.sub_matrix(range(NMO));
    auto hdn = hij.sub_matrix(range(NMO,2*NMO));
    linear_hij.emplace_back(math::sparse::linearize_matrix(hup));
    linear_hij.emplace_back(math::sparse::linearize_matrix(hdn));
    utils::check(linear_hij[0].extent(0) == 1, "Size mismatch");
    utils::check(linear_hij[1].extent(0) == 1, "Size mismatch");
  } else if(type == NONCOLLINEAR or type == NONCOLLINEAR_FT) {
    utils::check(hij.extent(0) == 2*NMO, "");
    linear_hij.reserve(1);
    linear_hij.emplace_back(math::sparse::linearize_matrix(hij));
    utils::check(linear_hij[0].extent(0) == 1, "Size mismatch");
  }

  // create compact version of linear_hij
  std::vector<csrM> compact_hij;
  compact_hij.reserve(linear_hij.size());
  for(int n=0; n<linear_hij.size(); ++n) 
    compact_hij.emplace_back(csrM({1,nIJ}, nIJ)); 
  for(int i=0; i<linear_hij.size(); i++) {
    for(int n=0; n<nIJ; n++) {
      auto IJ = n2IJ(n);
      compact_hij[i][0][n] = linear_hij[i][0][IJ];
    }
  }   

  if constexpr (MEM==HOST_MEMORY) {
    return SparseEnergy<MEM,REAL>( mpi, type, std::move(compact_hij), std::move(VJ), 
                  std::move(VX), std::move(U),  std::move(J), std::move(n2IJ), E0);
  } else {

    using csrM_dev = math::sparse::csr_matrix<ValueType, MEM, int, int>;
    csrM_dev U_d(U), J_d(J);
    std::vector<csrM_dev> VJ_d, VX_d, compact_hij_d;
    VJ_d.reserve(VJ.size());
    VX_d.reserve(VX.size());
    compact_hij_d.reserve(compact_hij.size());
    for(int n=0; n<compact_hij.size(); ++n)
      compact_hij_d.emplace_back(csrM_dev(compact_hij[n]));
    for(int n=0; n<VJ.size(); ++n)
      VJ_d.emplace_back(csrM_dev(VJ[n]));
    for(int n=0; n<VX.size(); ++n)
      VX_d.emplace_back(csrM_dev(VX[n]));

    return SparseEnergy<MEM,REAL>( mpi, type, std::move(compact_hij_d), std::move(VJ_d), 
                  std::move(VX_d), std::move(U_d),  std::move(J_d), std::move(n2IJ), E0);
  }
}


template<typename ValueType>
nda::array<long,1> ModelHamOpsGenerator::find_occupied_pairs(WALKER_TYPES type,
    std::vector<math::sparse::csr_matrix<ValueType, HOST_MEMORY, int, int>>& U, 
    std::vector<math::sparse::csr_matrix<ValueType, HOST_MEMORY, int, int>>& J)
{

  utils::check(type != CLOSED, " Error: Model Hamiltonians not allowed with CLOSED walkers. ");
  using nda::range;
  int npol = (type == NONCOLLINEAR or type == NONCOLLINEAR_FT ? 2 : 1 );
  utils::check(not U.empty() or not J.empty(), "Error: both U and J empty.");
  long M = U.empty() ? long(J[0].shape(1)) : long(U[0].shape(1));
  long M2 = npol*M;
  long Madd = M2-M;

  nda::array<long,1> n2IJ;
  {
    std::vector<long> IJ;
    IJ.reserve(20*M);
    // to avoid adding too many copies
    std::vector<bool> Idone(2*M, false);

    // General formula for COLLINEAR and NONCOLLINEAR
    // IJ = i*M2+j            for up/up
    //    = (i+M)*M2+j+Madd   for dn/dn
    for(int n=0; n<U.size(); ++n) {
      // U opposite spin
      for(long r=0; r<M; ++r) {
        for(long p=U[n].row_begin(r); p<U[n].row_end(r); ++p) {
          auto Uij = U[n].values(p);
          long j = long(U[n].columns(p));
          if( std::abs(Uij) < 1e-6 ) continue;
          if( r > j ) continue;
          if(not Idone[r]) {
            Idone[r] = true;
            IJ.push_back(r*M2+r);           // ( i up, i up)
            IJ.push_back((r+M)*M2+r+Madd);  // ( i dn, i dn)
          }
          if(not Idone[j]) {
            Idone[j] = true;
            IJ.push_back(j*M2+j);           // ( j up, j up)
            IJ.push_back((j+M)*M2+j+Madd);  // ( j dn, j dn)
          }
        }
      }
      // U same spin
      for(long r=0; r<M; ++r) {
        for(long p=U[n].row_begin(r+M); p<U[n].row_end(r+M); ++p) {
          auto Uij = U[n].values(p);
          long j = long(U[n].columns(p));
          if( std::abs(Uij) < 1e-6 ) continue;
          if( r >= j ) continue;
          if(not Idone[r]) {
            Idone[r] = true;
            IJ.push_back(r*M2+r);             // ( i up, i up)
            IJ.push_back((r+M)*M2+r+Madd);    // ( i dn, i dn)
          }
          if(not Idone[j]) {
            Idone[j] = true;
            IJ.push_back(j*M2+j);           // ( j up, j up)
            IJ.push_back((j+M)*M2+j+Madd);  // ( j dn, j dn)
          }
        }
      }
    }
    for(int n=0; n<J.size(); ++n) {
      for(long r=0; r<M; ++r) {
        for(long p=J[n].row_begin(r); p<J[n].row_end(r); ++p) {
          auto Jij = J[n].values(p);
          long j = long(J[n].columns(p));
          if( std::abs(Jij) < 1e-6 ) continue;
          if( r >= j ) continue;
          if(not Idone[r]) {
            Idone[r] = true;
            IJ.push_back(r*M2+r);            // ( i up, i up)
            IJ.push_back((r+M)*M2+r+Madd);   // ( i dn, i dn)
          }
          if(not Idone[j]) {
            Idone[j] = true;
            IJ.push_back(j*M2+j);           // ( j up, j up)
            IJ.push_back((j+M)*M2+j+Madd);  // ( j dn, j dn)
          }
          IJ.push_back(r*M2+j);            // ( i up, j up)
          IJ.push_back(j*M2+r);            // ( j up, i up)
          IJ.push_back((r+M)*M2+j+Madd);   // ( i dn, j dn)
          IJ.push_back((j+M)*M2+r+Madd);   // ( j dn, i dn)
        }
      }
    }

    std::sort(IJ.begin(), IJ.end());
    auto iend = std::unique(IJ.begin(), IJ.end());
    int nIJ = std::distance( IJ.begin(), iend );
    n2IJ = nda::array<long,1>(nIJ);
    std::copy_n(IJ.begin(), nIJ, n2IJ.data());

  }

  return n2IJ; 
}

/*
 * Calculates HS potentials, along with constant 1-body terms.
 * By convention, we define vHS with a factor of 'i' not included (based on the continuous
 * transformation as the original default, so a factor of '-i' is included in vn to compensate
 * for this. The term <vMF>*vn is included later by the Model Component class.
 *
 *  First (second) term for charge (spin) decomposition. 
 *  vn = (+-) sqrt( (+-) dt * UIJ ) * ( nI (+-) nJ ), where I/J are the spinor indexes
 *       associated with the nth term in the interaction and nI/nJ are density operators.
 *  h0 = (+-) 0.5 * dt * Uij * (nI + nJ)  
 *  *** the factor of (-1) coming from the propagator is not included in h0, since it is added later
 *  All factors of dt are added by Model Component class.
 *  
 *  Since the discrete transformation can not be constructed yet, (we do
 *  not yet have the mean field averages of onsite densities), we initalize
 *  structures in the discrete with the continuouas routines. The prefactors
 *  are fixed in the HamOps class.
 */
template<MEMORY_SPACE MEM, bool REAL, typename ValueType, class map_t>
void ModelHamOpsGenerator::addComponent( WALKER_TYPES wtype, PropagatorTypes ptype, 
     std::shared_ptr<utils::mpi_context_t<mpi3::communicator>> mpi,
     math::sparse::csr_matrix<ValueType, HOST_MEMORY, int, int>& U, 
     math::sparse::csr_matrix<ValueType, HOST_MEMORY, int, int>& J, 
     std::vector<ModelComponent<MEM,REAL>>& Hams, 
     nda::array<long,1>& n2IJ, map_t& IJ2n)
{
  using nda::range;
  utils::check(ptype == ContinuousChargePropagator or
	 ptype == ContinuousSpinPropagator or 
	 ptype == DiscreteChargePropagator or 
	 ptype == DiscreteSpinPropagator, "Invalid propagator type.");

  if( U.nnz()==0 and
      J.nnz()==0 )
    return;

  bool ContinuousPropg = (ptype == ContinuousChargePropagator or
			  ptype == ContinuousSpinPropagator);
  bool ChargePropg = (ptype == ContinuousChargePropagator or
		       ptype == DiscreteChargePropagator);			

  ComplexType minus_half(-0.5);
  RealType sign = (ChargePropg) ? RealType(1.0) : RealType(-1.0);
  int nIJ = n2IJ.extent(0);
  int nFields = 0;
  long M = long(U.extent(1));

  // count number of fields. +2 for (i!=j) and +1 for (i==j) terms.
  {
    utils::check(wtype == COLLINEAR or wtype == NONCOLLINEAR or wtype == COLLINEAR_FT
                  or wtype == NONCOLLINEAR_FT, "Invalid walker_type.");
    // opposite spin terms
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i); p<U.row_end(i); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i > j ) continue;
        if( i == j ) nFields++;   // 1 field for i==j 
        else nFields+=2;         // 2 fields for i!=j
      }
    } 
    // same spin terms
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i+M); p<U.row_end(i+M); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i >= j ) continue;
        nFields+=2;         // 2 fields for i!=j
      }
    }
    for(long i=0; i<M; ++i) {
      for(long p=J.row_begin(i); p<J.row_end(i); ++p) {
        auto Jij = J.values(p);
        long j = long(J.columns(p));
        if( std::abs(Jij) < 1e-6 ) continue;
        if( i >= j ) continue;   
        nFields++;         // 1 field per rho_ij term 
      }
    }
  }
  
  // return if no fields are found 
  if(nFields == 0) return; 

  // Vn, VnT, and h0 are in the compact n2IJ representation 
  // Vn(IJ, Field)
  // VnT(Field, IJ)
  // h0(0, IJ)  ... as a 1-row "linearized" sparse matrix   
  using csrM = math::sparse::csr_matrix<ComplexType, HOST_MEMORY, int, int>;
  csrM VnT({nFields, nIJ}, 4);
  nda::array<ComplexType,1> h0(nIJ, ComplexType(0.0));
  nFields = 0;
  bool writer = mpi->comm.root();

  int npol = (wtype == NONCOLLINEAR or wtype == NONCOLLINEAR_FT ? 2 : 1 );
  long M2 = npol*M;
  long Madd = M2-M;
  // General formula for COLLINEAR and NONCOLLINEAR
  // IJ = i*M2+j            for up/up
  //    = (i+M)*M2+j+Madd   for dn/dn
  
  { 
    // opposite spin terms
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i); p<U.row_end(i); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i > j ) continue;
        // add i up/j dn term 
        long I_ = i*M2+i;           // (i up, i up)
        auto nI = IJ2n[I_];
        long J_ = (j+M)*M2+j+Madd;  // (j dn, j dn)
        auto nJ = IJ2n[J_];
        ComplexType sqrtUij( std::sqrt(sign * Uij) );
        if(writer) h0(nI) += minus_half*sign*Uij;  
        if(writer) h0(nJ) += minus_half*sign*Uij;  
        VnT[nFields][nI] += sqrtUij;
        VnT[nFields++][nJ] += sign * sqrtUij;
        if( i != j ) {
          // add i dn/j up term 
          I_ = (i+M)*M2+i+Madd;      // (i dn, i dn)
          nI = IJ2n[I_];
          J_ = j*M2+j;               // (j up, j up)
          nJ = IJ2n[J_];
          if(writer) h0(nI) += minus_half*sign*Uij;  
          if(writer) h0(nJ) += minus_half*sign*Uij;  
          VnT[nFields][nI] += sqrtUij;
          VnT[nFields++][nJ] += sign * sqrtUij;     
        } 
      }
    }
    // same spin terms
    for(long i=0; i<M; ++i) {
      for(long p=U.row_begin(i+M); p<U.row_end(i+M); ++p) {
        auto Uij = U.values(p);
        long j = long(U.columns(p));
        if( std::abs(Uij) < 1e-6 ) continue;
        if( i >= j ) continue;
        // add up/up term 
        long I_ = i*M2+i;      // (i up, i up)
        auto nI = IJ2n[I_];
        long J_ = j*M2+j;      // (j up, j up)
        auto nJ = IJ2n[J_];
        ComplexType sqrtUij( std::sqrt(sign * Uij) );
        if(writer) h0(nI) += minus_half*sign*Uij;  
        if(writer) h0(nJ) += minus_half*sign*Uij;  
        VnT[nFields][nI] += sqrtUij;
        VnT[nFields++][nJ] += sign * sqrtUij;
        // add dn/dn term 
        I_ = (i+M)*M2+i+Madd;      // (i dn, i dn)
        nI = IJ2n[I_];
        J_ = (j+M)*M2+j+Madd;      // (j dn, j dn)
        nJ = IJ2n[J_];
        if(writer) h0(nI) += minus_half*sign*Uij;  
        if(writer) h0(nJ) += minus_half*sign*Uij;  
        VnT[nFields][nI] += sqrtUij;
        VnT[nFields++][nJ] += sign * sqrtUij;
      }
    } 
    for(long i=0; i<M; ++i) {
      for(long p=J.row_begin(i); p<J.row_end(i); ++p) {
        auto Jij = J.values(p);
        long j = long(J.columns(p));
        if( std::abs(Jij) < 1e-6 ) continue;
        if( i >= j ) continue;  
        ComplexType sqrtJij( std::sqrt(sign * Jij) );
        long ii_up = i*M2+i;           // (i up, i up)
        long jj_up = j*M2+j;           // (j up, j up)
        long ii_dn = (i+M)*M2+i+Madd;  // (i dn, i dn)
        long jj_dn = (j+M)*M2+j+Madd;  // (j dn, j dn)
        long ij_up = i*M2+j;           // (i up, j up)
        long ji_up = j*M2+i;           // (j up, i up)
        long ij_dn = (i+M)*M2+j+Madd;  // (i dn, j dn)
        long ji_dn = (j+M)*M2+i+Madd;  // (j dn, i dn)
        auto nii_up = IJ2n[ii_up];
        auto njj_up = IJ2n[jj_up];
        auto nii_dn = IJ2n[ii_dn];
        auto njj_dn = IJ2n[jj_dn];
        auto nij_up = IJ2n[ij_up];
        auto nji_up = IJ2n[ji_up];
        auto nij_dn = IJ2n[ij_dn];
        auto nji_dn = IJ2n[ji_dn];
        if(writer) h0(nii_up) += minus_half*sign*Jij;  
        if(writer) h0(njj_up) += minus_half*sign*Jij;  
        if(writer) h0(nii_dn) += minus_half*sign*Jij;  
        if(writer) h0(njj_dn) += minus_half*sign*Jij;  
        VnT[nFields][nij_up] += sqrtJij; 
        VnT[nFields][nji_up] += sqrtJij; 
        VnT[nFields][nij_dn] += sign * sqrtJij;
        VnT[nFields++][nji_dn] += sign * sqrtJij;
      }
    }
  }

  // make sparse matrix compact, necessary in some libraries
  VnT.remove_empty_spaces();

  nda::array<ComplexType,2> Vn_array = math::sparse::to_array<'T'>(VnT);
  csrM SpVn = math::sparse::to_csr<HOST_MEMORY,int,int>(Vn_array);

  auto h0_dev = memory::share_from_root(*mpi, [&] { return memory::to_memory_space<MEM>(std::move(h0)); });

  if(ContinuousPropg)
    Hams.emplace_back( ModelComponent<MEM,REAL>( 
                       Continuous_GeneralUJ<MEM>(mpi,wtype,ptype,
						std::move(h0_dev),SpVn,VnT,shift_1body) ) );
  else
    Hams.emplace_back( ModelComponent<MEM,REAL>( 
                       Discrete_GeneralUJ<MEM,REAL>(mpi,wtype,ptype,
						std::move(h0_dev),SpVn,VnT,U,shift_1body) ) );
}

} // namespace afqmc

} // namespace sfqmc
