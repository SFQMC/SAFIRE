/*
 * Propagates the walker population nsteps forward. 
 */
template<MEMORY_SPACE MEM>
template<class WlkSet>
void AFQMCBasePropagator<MEM>::Propagate(WlkSet& wset, RealType Eshift, RealType dt, int nt)
{
  wfn->begin_inner_step(wset);
  AFQMCTimer.start(setup_timer);
  auto walker_type = wset.getWalkerType();
  int nwalk        = wset.size();
  int npol  = walker_type == NONCOLLINEAR ? 2 : 1;
  int nspin = walker_type == COLLINEAR ? 2 : 1;
  // Orbital count inferred from the walker Slater matrices (nwalk, npol*NMO, naea).
  const int NMO = int(wset.SlaterMatrices(Alpha).extent(1)) / npol;
  SPRealType sqrtdt  = std::sqrt(SPRealType(dt));
  int nCV     = wfn->number_of_cholesky_vectors();
  bool step0 = false;
  bool ft = wset.isFiniteTemperature();

  memory::buffered_array<MEM,ComplexType,1> MFfactor(nwalk,ComplexType(0.0));
  memory::buffered_array<MEM,ComplexType,1> hybrid_weight(nwalk,ComplexType(0.0));
  memory::buffered_array<MEM,ComplexType,1> new_overlaps(nwalk,ComplexType(0.0));
  memory::buffered_array<MEM,ComplexType,2> new_energies(nwalk,3);
  new_energies() = ComplexType(0.0);

  // if timestep changed, recalculate one body propagator and vMF
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, walker_type);
  AFQMCTimer.stop(setup_timer);

  // store current time-slice for finite-T walkers
  if (ft)
    wset.setTauStep(nt);

  memory::buffered_array<MEM,ComplexType,2> X(nwalk, nCV);
  // 1. Calculate vbias for initial configuration
  if (free_projection)
  {
    X() = ComplexType(0.0);
  }
  else
  {
    if(!ft)
      wfn->vbias(wset, X, dt);
    else
      wfn->vbias(wset, X, dt, nt-1);
  }

  // 2. Assemble X(nwalk, nCV)
  AFQMCTimer.start(assemble_X_timer);
  assemble_X(sqrtdt, X, MFfactor, hybrid_weight);
  AFQMCTimer.stop(assemble_X_timer);

  //std::cout<<" X: " <<nda::sum(nda::to_host(X)) <<std::endl;

  // Store sqrtdt*X in wset if back propagating
  int bp_step = wset.getBPPos(), bp_max = wset.NumBackProp();
  if (bp_step >= 0 && bp_step < bp_max)
    wset.storeFields(bp_step,X);

  if(denseP2) {
    // 3. Calculate vHS
    AFQMCTimer.start(vHS_timer);
    auto vHS = wfn->vHS(X, dt);
    utils::check(vHS.shape() == std::array<long,4>{nspins_in_vHS,nwalk,npol_in_vHS*NMO,NMO}, 
                 "Size mismatch");
    AFQMCTimer.stop(vHS_timer);

    // 4. Propagate walkers
    AFQMCTimer.start(propagate_timer);
    apply_propagators<'N'>(wset,vHS); 
    AFQMCTimer.stop(propagate_timer);
  } else {
    // 3. Calculate vHS
    AFQMCTimer.start(vHS_timer);
    auto vHS = wfn->vHS_sparse(X, dt);
    utils::check(vHS.extent(0) == nspin, "Size mismatch"); 
    utils::check((vHS(0).shape() == std::array<long,2>{nwalk*npol*NMO,nwalk*npol*NMO}) and
                 (vHS(nspin-1).shape() == std::array<long,2>{nwalk*npol*NMO,nwalk*npol*NMO}),
                 "Size mismatch"); 
    AFQMCTimer.stop(vHS_timer);

    // 4. Propagate walkers
    AFQMCTimer.start(propagate_timer);
    apply_propagators<'N'>(wset,vHS);
    AFQMCTimer.stop(propagate_timer);
  }

  // 5. Calculate local energy/overlap
  AFQMCTimer.start(pseudo_energy_timer);
  if (hybrid)
    wfn->Log_Overlap(wset, new_overlaps);
  else
    wfn->Energy(wset, new_energies, new_overlaps);
  AFQMCTimer.stop(pseudo_energy_timer);


  // 6. update weights/energy/etc, apply constrains/bounds/etc
  AFQMCTimer.start(extra_timer);
  if (free_projection)
  {
    free_projection_walker_update(wset, dt, new_overlaps, MFfactor, Eshift, hybrid_weight,debug_verbosity);
  }
  else if (hybrid)
  {
    if(nt==1) step0 = true; 
    hybrid_walker_update(wset, dt, apply_constrain, importance_sampling, Eshift, new_overlaps, MFfactor,
                         hybrid_weight, lower_cutoff_scale, upper_cutoff_scale, symmetric_split, step0,
                         debug_verbosity, use_cp_constraint, eloc_bound_stats);
  }
  else
  {
    local_energy_walker_update(wset, dt, apply_constrain, Eshift, new_overlaps, new_energies, MFfactor,
                               lower_cutoff_scale, upper_cutoff_scale, eloc_bound_stats);
  }
  if (wset.getBPPos() >= 0) {
    if(wset.getBPPos() < wset.NumBackProp()) wset.advanceBPPos();
    wset.advanceHistoryPos();
  }
  AFQMCTimer.stop(extra_timer);
}

/*
 * StochasticWfn: one walker-conditioned field-sampling step on the inner ensemble.
 * Seeds the fields with the externally supplied per-walker conditioning bias Xbias(nwalk,nCV), then
 * runs assemble_X -> vHS -> apply_propagators. Skips the energy/overlap and walker-weight update: the
 * propagated determinants are field samples; the StochasticWfn reductions weight them by 1/P and the
 * phase S_p from the cross overlap, not by inner walker weights. The conditioned inner propagator is
 * built with free_projection = false, so assemble_X applies the supplied bias (importance sampling).
 */
template<MEMORY_SPACE MEM>
template<class WlkSet>
void AFQMCBasePropagator<MEM>::Propagate_conditioned(WlkSet& wset,
     nda::MemoryArrayOfRank<2> auto const& Xbias, RealType dt, int nt,
     nda::array<ComplexType, 1>* hw_out)
{
  (void)nt;
  auto walker_type = wset.getWalkerType();
  int nwalk        = wset.size();
  auto [nspins, npol] = walkerTypeToDims(walker_type);
  const int NMO    = int(wset.SlaterMatrices(Alpha).extent(1)) / npol;
  SPRealType sqrtdt  = std::sqrt(SPRealType(dt));
  int nCV     = wfn->number_of_cholesky_vectors();

  utils::check(not free_projection,
               "Error in Propagate_conditioned: conditioned inner sampling requires the inner "
               "propagator to be built with free_projection = false (importance sampling).");
  utils::check(Xbias.shape() == std::array<long,2>{nwalk,nCV},
               "Error in Propagate_conditioned: Xbias shape mismatch.");

  memory::buffered_array<MEM,ComplexType,1> MFfactor(nwalk,ComplexType(0.0));
  memory::buffered_array<MEM,ComplexType,1> hybrid_weight(nwalk,ComplexType(0.0));

  // if timestep changed, recalculate one body propagator and vMF (vMF centers the conditioning bias)
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, walker_type);

  // 1. Seed X with the externally supplied conditioning force bias (instead of wfn->vbias, which would
  //    self-condition on the inner trial rather than the outer walker).
  memory::buffered_array<MEM,ComplexType,2> X(nwalk, nCV);
  X() = Xbias();

  // 2. Assemble X: importance-sampling shift im*(vbias - vMF) + Gaussian noise.
  assemble_X(sqrtdt, X, MFfactor, hybrid_weight);

  // Optional: copy the per-walker Girsanov weight HW = log(p_T/q) to the caller before it is discarded.
  if (hw_out)
    *hw_out = nda::to_host(hybrid_weight);

  // 3-4. vHS and propagate the inner walkers.
  if(denseP2) {
    auto vHS = wfn->vHS(X, dt);
    utils::check(vHS.shape() == std::array<long,4>{nspins_in_vHS,nwalk,npol_in_vHS*NMO,NMO},
                 "Size mismatch");
    apply_propagators<'N'>(wset,vHS);
  } else {
    auto vHS = wfn->vHS_sparse(X, dt);
    apply_propagators<'N'>(wset,vHS);
  }
  (void)npol;
  (void)nspins;
}

/*
 * Free-projection field-sampling step, decoupled from the propagator's build mode. Draws bare auxiliary
 * fields Y ~ p_T(Y) (no force bias, no vMF shift) and applies B_T(Y) = exp(vHS) to the walkers, then
 * stops. Used by StochasticWfn to draw walker-INDEPENDENT free-projection trial samples
 * {psi_p = B_T(Y^[p])|phi_T>} for back-propagation references, regardless of whether the (forward) inner
 * propagator was built for walker-independent free projection or walker-conditioned importance sampling. Forces
 * bare field assembly by toggling free_projection around assemble_X (which reads that member), then
 * restores it: construct_X then ignores the zero vbias and vMF and produces X = sqrtdt * Gaussian noise.
 * Like Propagate_conditioned, skips the energy/overlap and walker-weight update -- the propagated
 * determinants are field samples, not weighted walkers.
 */
template<MEMORY_SPACE MEM>
template<class WlkSet>
void AFQMCBasePropagator<MEM>::Propagate_free(WlkSet& wset, RealType dt, int nt)
{
  (void)nt;
  auto walker_type = wset.getWalkerType();
  int nwalk        = wset.size();
  auto [nspins, npol] = walkerTypeToDims(walker_type);
  const int NMO    = int(wset.SlaterMatrices(Alpha).extent(1)) / npol;
  SPRealType sqrtdt  = std::sqrt(SPRealType(dt));
  int nCV     = wfn->number_of_cholesky_vectors();

  // if timestep changed, recalculate one body propagator and vMF
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, walker_type);

  memory::buffered_array<MEM,ComplexType,1> MFfactor(nwalk,ComplexType(0.0));
  memory::buffered_array<MEM,ComplexType,1> hybrid_weight(nwalk,ComplexType(0.0));
  memory::buffered_array<MEM,ComplexType,2> X(nwalk, nCV);
  X() = ComplexType(0.0);

  // Force bare (free-projection) field assembly regardless of build mode. The free_projection member is
  // toggled only for the assemble_X call and restored on scope exit by the RAII guard (robust to an early
  // return / abort inside assemble_X). NOTE: this assumes a single-threaded call on this propagator
  // instance -- true today (one Propagator variant alternative, no intra-propagator threading); if a
  // future propagator type mutates shared state across threads this toggle would need revisiting.
  {
    struct FreeProjGuard
    {
      bool& flag;
      bool  saved;
      explicit FreeProjGuard(bool& f) : flag(f), saved(f) { flag = true; }
      ~FreeProjGuard() { flag = saved; }
    } fp_guard(free_projection);
    assemble_X(sqrtdt, X, MFfactor, hybrid_weight);
  }

  if(denseP2) {
    auto vHS = wfn->vHS(X, dt);
    utils::check(vHS.shape() == std::array<long,4>{nspins_in_vHS,nwalk,npol_in_vHS*NMO,NMO},
                 "Size mismatch");
    apply_propagators<'N'>(wset,vHS);
  } else {
    auto vHS = wfn->vHS_sparse(X, dt);
    apply_propagators<'N'>(wset,vHS);
  }
  (void)npol;
  (void)nspins;
}

/*
 * Applies B_T(X) for caller-supplied auxiliary fields X(nwalk,nCV): vHS -> apply_propagators, nothing
 * else. No field generation, no RNG consumption, no MFfactor/hybrid-weight bookkeeping, no weight
 * update -- the deterministic companion of Propagate_free, so re-feeding the fields Propagate_free
 * drew reproduces its walkers exactly. Callers own the meaning of X (for the bare free-projection
 * convention, X holds standard-normal draws; see construct_X).
 */
template<MEMORY_SPACE MEM>
template<class WlkSet>
void AFQMCBasePropagator<MEM>::Propagate_given_fields(WlkSet& wset,
     nda::MemoryArrayOfRank<2> auto& X, RealType dt)
{
  auto walker_type = wset.getWalkerType();
  int nwalk = wset.size();
  int npol  = walker_type == NONCOLLINEAR ? 2 : 1;
  const int NMO = int(wset.SlaterMatrices(Alpha).extent(1)) / npol;
  int nCV   = wfn->number_of_cholesky_vectors();
  utils::check(X.shape() == std::array<long,2>{nwalk,nCV},
               "Error in Propagate_given_fields: X shape mismatch.");

  // if timestep changed, recalculate one body propagator and vMF
  if (std::abs(dt - old_dt) > 1e-6)
    generateP1(dt, wset.getWalkerType());

  if(denseP2) {
    auto vHS = wfn->vHS(X, dt);
    utils::check(vHS.shape() == std::array<long,4>{nspins_in_vHS,nwalk,npol_in_vHS*NMO,NMO},
                 "Size mismatch");
    apply_propagators<'N'>(wset,vHS);
  } else {
    auto vHS = wfn->vHS_sparse(X, dt);
    apply_propagators<'N'>(wset,vHS);
  }
}

/*
 * This routine assumes that the 1 body propagator does not need updating
 * Input:
 *  - nbsteps: # of back propagation steps to perform.
 *  - nStabalize: # of steps between ortogonalization
 *  - wset: walker set, contains field history
 *  - Refs(nwalk, number_of_references, npol*NMO, nel)
 *  - logdetR(nwalk, number_of_references)
 */
template<MEMORY_SPACE MEM>
template<class WlkSet>
void AFQMCBasePropagator<MEM>::BackPropagate(int nbpsteps, int nStabalize, WlkSet& wset, 
        nda::MemoryArrayOfRank<4> auto&& Refs, nda::MemoryArrayOfRank<2> auto&& logdetR) 
{
  using nda::range;
  auto all = range::all;
  auto walker_type = wset.getWalkerType();
  int npol         = (walker_type == NONCOLLINEAR) ? 2 : 1;
  int nspin        = (walker_type == COLLINEAR) ? 2 : 1;
  int nwalk        = wset.size();
  int nCV          = wfn->number_of_cholesky_vectors();
  int nrefs        = Refs.extent(1);
  // Dimensions inferred from the walker Slater matrices (nwalk, npol*NMO, naea/naeb).
  const int NMO    = int(wset.SlaterMatrices(Alpha).extent(1)) / npol;
  const int nup    = int(wset.SlaterMatrices(Alpha).extent(2));
  const int ndown  = (walker_type == COLLINEAR) ? int(wset.SlaterMatrices(Beta).extent(2)) : 0;
  int nel          = ( walker_type==COLLINEAR ? nup+ndown : nup );

  utils::check(Refs.shape() == std::array<long,4>{nwalk,nrefs,npol*NMO,nel}, 
               "Size mismatch");
  utils::check(logdetR.shape() == std::array<long,2>{nwalk,nrefs}, "Size mismatch");

  // Fields(nwalk, steps, nCV)
  auto Fields = wset.getFields();
  utils::check(Fields.extent(1) >= nbpsteps, "Size mismatch");
  utils::check(Fields.extent(0) == nwalk and Fields.extent(2) == nCV, "Size mismatch");

  memory::buffered_array<MEM,ComplexType,3> SMA(nwalk, npol*NMO, nup);
  memory::buffered_array<MEM,ComplexType,3> SMB(nwalk, npol*NMO, 
                                                (walker_type==COLLINEAR ? ndown : 0));
  memory::buffered_array<MEM,ComplexType,2> X(nwalk, nCV);
  memory::buffered_array<MEM,ComplexType,1> ldet(nwalk);
  logdetR() = ComplexType(0.0);

  // 0. copy SlaterMatrix to SMA/SMB
  if(nup > 0) {
    SMA() = wset.SlaterMatrices(Alpha);
  }
  if(walker_type==COLLINEAR && ndown > 0) {
    SMB() = wset.SlaterMatrices(Beta);
  }
  
  for (int ni = nbpsteps - 1; ni >= 0; --ni)
  {
    // 1. Get X(nwalk,nCV) from wset
    X() = Fields(all,ni,all); 

    if(denseP2) {

      // 2. Calculate vHS
      auto vHS = wfn->vHS(X, old_dt);
      utils::check(vHS.shape() == std::array<long,4>{nspins_in_vHS,nwalk,npol_in_vHS*NMO,NMO},
                 "Size mismatch");

      // MAM: can do all references together in principle, 
      //      would consume more memory but be very efficient in GPU! 
      for (int nr = 0; nr < nrefs; ++nr)
      {
        // 3. copy reference to SlaterMatrix
        if(nup > 0) {
          wset.SlaterMatrices(Alpha) = Refs(all,nr,all,range(nup));
        }
        if(walker_type==COLLINEAR && ndown > 0) {
          wset.SlaterMatrices(Beta) = Refs(all,nr,all,range(nup,nup+ndown));        
        }

        // 4. Propagate walkers 
        apply_propagators<'H'>(wset,vHS); 

        // always end (n==0) with an orthogonalization
        if (ni == 0 || ni % nStabalize == 0) {
          ldet() = ComplexType(0.0);
          det_ops::orthogonalize(wset, ldet);
          nda::tensor::add(ComplexType(1.0),ldet,"w",ComplexType(1.0),logdetR(all,nr),"w");
        }

        // 5. copy reference to back
        if(nup > 0) {
          Refs(all,nr,all,range(nup)) = wset.SlaterMatrices(Alpha);
        }
        if(walker_type==COLLINEAR && ndown > 0)
          Refs(all,nr,all,range(nup,nup+ndown)) = wset.SlaterMatrices(Beta);
      }

    } else {

      // 2. Calculate vHS
      auto vHS = wfn->vHS_sparse(X, old_dt);
      utils::check(vHS.extent(0) == nspin, "Size mismatch");
      utils::check((vHS(0).shape()==std::array<long,2>{nwalk*npol*NMO,nwalk*npol*NMO}) and
               (vHS(nspin-1).shape() == std::array<long,2>{nwalk*npol*NMO,nwalk*npol*NMO}),
               "Size mismatch");

      for (int nr = 0; nr < nrefs; ++nr)
      { 
        // 3. copy reference to SlaterMatrix
        wset.SlaterMatrices(Alpha) = Refs(all,nr,all,range(nup));
        if(walker_type==COLLINEAR)
          wset.SlaterMatrices(Beta) = Refs(all,nr,all,range(nup,nup+ndown));
        
        // 4. Propagate walkers
        apply_propagators<'H'>(wset,vHS); 
        
        // always end (n==0) with an orthogonalization
        if (ni == 0 || ni % nStabalize == 0) {
          ldet() = ComplexType(0.0);
          det_ops::orthogonalize(wset, ldet);
          nda::tensor::add(ComplexType(1.0),ldet,"w",ComplexType(1.0),logdetR(all,nr),"w");
        }
        
        // 5. copy reference to back
        Refs(all,nr,all,range(nup)) = wset.SlaterMatrices(Alpha);
        if(walker_type==COLLINEAR)
          Refs(all,nr,all,range(nup,nup+ndown)) = wset.SlaterMatrices(Beta);
      }

    }
  }

  // 6. restore the Slater Matrix
  wset.SlaterMatrices(Alpha) = SMA();
  if(walker_type==COLLINEAR)
    wset.SlaterMatrices(Beta) = SMB();

  mpi->comm.barrier();
}

/*
 * Propagate "operator states" forward in time using stored fields.
 */
template<MEMORY_SPACE MEM>
template<class WlkSet>
void AFQMCBasePropagator<MEM>::PropagateOperators(int nsteps, WlkSet& wset, 
        nda::MemoryArrayOfRank<4> auto&& X, nda::MemoryArrayOfRank<4> auto&& Y, 
        nda::MemoryArrayOfRank<4> auto&& M)
{ 
  using nda::range;
  auto all = range::all;
  auto walker_type = wset.getWalkerType();
  int npol         = (walker_type == NONCOLLINEAR) ? 2 : 1;
  int nspin        = (walker_type == COLLINEAR) ? 2 : 1;
  int nwalk        = wset.size();
  int nCV          = wfn->number_of_cholesky_vectors();
  int bp_step      = wset.getBPPos();
  ComplexType one(1.0,0.0);
  // Dimensions inferred from the walker Slater matrices (nwalk, npol*NMO, naea/naeb).
  const int NMO    = int(wset.SlaterMatrices(Alpha).extent(1)) / npol;
  const int nup    = int(wset.SlaterMatrices(Alpha).extent(2));
  const int ndown  = (walker_type == COLLINEAR) ? int(wset.SlaterMatrices(Beta).extent(2)) : 0;

  // Fields(nwalk, steps, nCV)
  auto Fields = wset.getFields();
  utils::check(Fields.extent(1) >= nsteps, "Size mismatch");
  utils::check(Fields.extent(0) == nwalk and Fields.extent(2) == nCV, "Size mismatch");
  utils::check(bp_step > 0 and bp_step >= nsteps, "Error in PropagateOperators: bp_step:{}, nstep:{}",bp_step,nsteps);

  // generate P1x_inv if not yet constructed
  // NOTE: if time step changes after this point, 
  // it will be updated with the regular propagator, so only need to create it once here
  if(P1s_inv.size() != nspin)
    generateP1(old_dt, walker_type, true);
  
  { 
    memory::buffered_array<MEM,ComplexType,2> Xfield(nwalk, nCV);
    // MAM: Regularization is done after all nsteps are applied.
    //      If this leads to instabilities (e.g. for large nsteps),
    //      apply regularization inside this loop with some frequency
    for (int i = 0, ni=bp_step-nsteps; i <nsteps; ++i, ++ni)
    {

      // 1. Get Xfield(nwalk,nCV) from wset
      Xfield() = Fields(all,ni,all);

      if(denseP2) {

        // 2. Calculate vHS
        auto vHS = wfn->vHS(Xfield, old_dt);
        utils::check(vHS.shape() == std::array<long,4>{nspins_in_vHS,nwalk,npol_in_vHS*NMO,NMO},
                   "Size mismatch");

        // 4. Propagate walkers 
        apply_propagators<'N'>(walker_type,npol,X(all,0,all,all),X(all,nspin-1,all,all),vHS);
        // scale vHS by -1, since we need ma::H( B^(-1) )
        nda::tensor::scale(ComplexType(-1.0),vHS);
        apply_propagators<'H'>(walker_type,npol,Y(all,0,all,all),Y(all,nspin-1,all,all),vHS,true);
      } else {

        // 2. Calculate vHS
        auto vHS = wfn->vHS_sparse(Xfield, old_dt);
        utils::check(vHS.extent(0) == nspin, "Size mismatch");
        utils::check((vHS(0).shape()==std::array<long,2>{nwalk*npol*NMO,nwalk*npol*NMO}) and
                 (vHS(nspin-1).shape() == std::array<long,2>{nwalk*npol*NMO,nwalk*npol*NMO}),
                 "Size mismatch");

        // 4. Propagate walkers 
        apply_propagators<'N'>(walker_type,npol,X(all,0,all,all),X(all,nspin-1,all,all),vHS);
        // scale vHS by -1, since we need ma::H( B^(-1) )
        nda::tensor::scale(ComplexType(-1.0),vHS(0).values());
        if(nspin==2)
          nda::tensor::scale(ComplexType(-1.0),vHS(1).values());
        apply_propagators<'H'>(walker_type,npol,Y(all,0,all,all),Y(all,nspin-1,all,all),vHS,true);

      }

    }

  }

  // 4.Regularize states using the current walker's Slater Matrix (which should be orthonormal)
  // Ynew = S * H(S) * Y
  // M += H(Ynew) * X
  // Xnew = X - S * H(S) * X  
  // where S is the walker's Slater Matrix. 
  SpinTypes stype[2] = {Alpha, Beta};
  int nel[2] = {nup, ndown};

  if constexpr (MEM==HOST_MEMORY) {

    for(int ispin=0; ispin<nspin; ispin++) {

      auto SM = wset.SlaterMatrices(stype[ispin]); 
      memory::buffered_array<MEM,ComplexType,2> SY(nel[ispin], npol*NMO);

      for(int iw=0; iw<nwalk; ++iw) {

        auto SM_iw  = SM(iw,all,all); 
        auto X_iw  = X(iw,ispin,all,all);
        auto Y_iw  = Y(iw,ispin,all,all);
        auto M_iw  = M(iw,ispin,all,all);

        // SY = H(S) * Y
        nda::blas::gemm(nda::dagger(SM_iw),Y_iw,SY);

        // Ynew = S * SY
        nda::blas::gemm(SM_iw,SY,Y_iw);
        
        // M += H(Ynew) * X
        nda::blas::gemm(one,nda::dagger(Y_iw),X_iw,one,M_iw);
     
        // SY = H(S) * X
        nda::blas::gemm(nda::dagger(SM_iw),X_iw,SY);
        
        // Xnew = X - S * SY
        nda::blas::gemm(-one,SM_iw,SY,one,X_iw);

      } // iw

    } // ispin
      
  } else {

    for(int ispin=0; ispin<nspin; ispin++) {

      memory::buffered_array<MEM,ComplexType,3> SY(nwalk, nel[ispin], npol*NMO);

      // SY = H(S) * Y
      nda::tensor::contract(nda::conj(wset.SlaterMatrices(stype[ispin])), "nki",
                       Y(all,ispin,all,all), "nkj", SY, "nij");

      // Ynew = S * SY
      nda::tensor::contract(wset.SlaterMatrices(stype[ispin]), "nik",
                       SY, "nkj", Y(all,ispin,all,all), "nij");

      // M += H(Ynew) * X
      nda::tensor::contract(one, nda::conj(wset.SlaterMatrices(stype[ispin])), "nki",
                                 X(all,ispin,all,all), "nkj",
                            one, M(all,ispin, all, all), "nij"); 

      // SY = H(S) * X
      nda::tensor::contract(nda::conj(wset.SlaterMatrices(stype[ispin])), "nki",
                       X(all,ispin,all,all), "nkj", SY, "nij");

      // Xnew = X - S * SY
      nda::tensor::contract(-one, wset.SlaterMatrices(stype[ispin]), "nik", SY, "nkj",
                            one, X(all,ispin,all, all), "nij"); 

    } // ispin

  } // MEM
  mpi->comm.barrier();
}

